      "url": "/list/mcp-accesses",
      "auth": "user",
      "wait": {
        "selector": ".fm-table, .list-filters, .generic-list-mobile-cards > *"
      },
      "actions": [
        {
          "click": "#New"
        }
      ],
      "waitAfter": {
        "selector": ".mcp-wizard, .split-dialog, .modal-overlay"
      },
      "settle": 800,
      "note": "McpAccessCreateWizard; erfordert aktiviertes MCP-Feature, sonst Datenluecke."
    },
    {
      "id": "overlay-confirm-dialog",
      "group": "overlay",
      "url": "/card/contacts/{api:api/contacts}",
      "auth": "user",
      "wait": {
        "selector": ".card-table, .fm-table, main, .generic-list-mobile-cards > *"
      },
      "actions": [
        {
          "click": "#Delete"
        }
      ],
      "waitAfter": {
        "selector": ".confirm-dialog, .modal-overlay, .split-dialog"
      },
      "settle": 500,
      "postActions": [
        {
          "click": ".confirm-dialog .btn.secondary, .modal-overlay .btn.secondary"
        }
      ],
      "note": "Globaler Bestaetigungsdialog (ConfirmationService) am Delete-Ribbon der Kontaktkarte; wird nach der Aufnahme mit Abbrechen geschlossen."
    }
