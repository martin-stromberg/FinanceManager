{
  "description": "Routen-/Zustandsmatrix fuer den Inventarlauf (generate-inventory.js). Jede Ansicht wird in beiden Viewports im Dark-Mode als PNG + HTML-Dump erfasst. Platzhalter {api:<pfad>} in URLs werden zur Laufzeit gegen die erste ID der List-API aufgeloest (verschachtelt moeglich). auth: public = ausgeloggter Kontext, user = eingeloggt (Demodaten-Benutzer), admin = eingeloggt + Admin-Anspruch erforderlich (Erstbenutzer ist automatisch Admin).",
  "viewports": {
    "desktop": {
      "width": 1280,
      "height": 900
    },
    "mobile": {
      "width": 390,
      "height": 844
    }
  },
  "views": [
    {
      "id": "login",
      "group": "public",
      "url": "/login",
      "auth": "public",
      "wait": {
        "selector": "#login-user"
      }
    },
    {
      "id": "register",
      "group": "public",
      "url": "/register",
      "auth": "public",
      "wait": {
        "selector": "#username"
      },
      "note": "Erster-Benutzer-Zustand inkl. #create-demo-data; wird vor der Registrierung erfasst."
    },
    {
      "id": "error",
      "group": "public",
      "url": "/Error",
      "auth": "public",
      "wait": {
        "selector": "body"
      },
      "settle": 600
    },
    {
      "id": "legal",
      "group": "public",
      "url": "/legal",
      "auth": "public",
      "wait": {
        "selector": "body"
      },
      "settle": 600
