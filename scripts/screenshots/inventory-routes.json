        "namePrefix": "setup-section",
        "settle": 800
      },
      "note": "Erfasst jede aufklappbare Setup-Sektion einzeln (Anzahl dynamisch: 10-11, mcp-Sektion nur bei aktiviertem MCP-Feature)."
    },
    {
      "id": "overlay-home-mass-import",
      "group": "overlay",
      "url": "/",
      "auth": "user",
      "wait": {
        "selector": ".fm-ribbon, h1"
      },
      "actions": [
        {
          "setInputFiles": {
            "selector": "#Import input[type='file']",
            "file": "$DEMO_CSV"
          }
        }
      ],
      "waitAfter": {
        "selector": ".mass-import-dialog, .split-dialog"
      },
      "settle": 800,
      "note": "Mass-Import-Dialog; Startseite kann je nach Circuit-Zustand signed-out rendern."
    },
    {
      "id": "overlay-budget-settings",
      "group": "overlay",
      "url": "/reports/budget",
      "auth": "user",
      "wait": {
        "selector": ".budget-report-table"
      },
      "actions": [
        {
          "click": "#Settings"
        }
      ],
      "waitAfter": {
        "selector": ".split-dialog"
      },
      "settle": 500
    },
    {
      "id": "overlay-dashboard-filters",
      "group": "overlay",
