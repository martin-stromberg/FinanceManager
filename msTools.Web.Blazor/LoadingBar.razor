@inject Microsoft.Extensions.Options.IOptions<LoadingBarOptions> Options

@{
    var resolvedOptions = Options.Value;
    var elementId = ElementId ?? resolvedOptions.ElementId;
    var cssClass = string.Join(
        " ",
        new[] { "mst-loading-bar", CssClass ?? resolvedOptions.CssClass }.Where(value => !string.IsNullOrWhiteSpace(value)));
    var style = BuildStyle(resolvedOptions);
    var colors = Colors ?? resolvedOptions.Colors;
    var mobileBreakpoint = MobileBreakpoint ?? resolvedOptions.MobileBreakpoint;
}

<div id="@elementId"
     class="@cssClass"
     style="@style"
     data-mst-loading-bar
     data-loading-colors="@string.Join(",", colors)"
     aria-hidden="true"></div>

<style>
    @@media (max-width: @mobileBreakpoint) {
        #@elementId {
            top: var(--mst-loading-bar-mobile-top, var(--mst-loading-bar-top, 0));
        }
    }
</style>

@code {
    /// <summary>
    /// Gets or sets the DOM id used by the JavaScript bridge.
    /// </summary>
    [Parameter] public string? ElementId { get; set; }

    /// <summary>
    /// Gets or sets additional CSS classes for host-specific styling.
    /// </summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>
    /// Gets or sets the host-provided color palette used on each restart.
    /// </summary>
    [Parameter] public IReadOnlyList<string>? Colors { get; set; }

    /// <summary>
    /// Gets or sets the loading bar height as CSS length.
    /// </summary>
    [Parameter] public string? Height { get; set; }

    /// <summary>
    /// Gets or sets the desktop top offset as CSS length.
    /// </summary>
    [Parameter] public string? Top { get; set; }

    /// <summary>
    /// Gets or sets the mobile top offset as CSS length.
    /// </summary>
    [Parameter] public string? MobileTop { get; set; }

    /// <summary>
    /// Gets or sets the maximum width at which the mobile top offset applies.
    /// </summary>
    [Parameter] public string? MobileBreakpoint { get; set; }

    /// <summary>
    /// Gets or sets the z-index used by the loading bar.
    /// </summary>
    [Parameter] public int? ZIndex { get; set; }

    private string BuildStyle(LoadingBarOptions options)
    {
        var height = Height ?? options.Height;
        var top = Top ?? options.Top;
        var mobileTop = MobileTop ?? options.MobileTop;
        var zIndex = ZIndex ?? options.ZIndex;

        return string.Join(
            ";",
            new[]
            {
                $"--mst-loading-bar-height:{height}",
                $"--mst-loading-bar-top:{top}",
                $"--mst-loading-bar-mobile-top:{mobileTop}",
                $"--mst-loading-bar-z-index:{zIndex}"
            });
    }
}
