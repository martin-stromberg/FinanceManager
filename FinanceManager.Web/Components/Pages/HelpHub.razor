@page "/help"
@layout FinanceManager.Web.Components.Layout.HelpLayout
@using System.Globalization
@using FinanceManager.Web.Services.Help
@inject IHelpAssetIntegrityValidator HelpAssetIntegrityValidator
@inject IWebHostEnvironment Environment

@{
    var lang = language;
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-12">
            <h1>
                @(lang == "en" ? "📖 Help & Documentation" : "📖 Hilfe & Dokumentation")
            </h1>
            <p class="lead text-muted">
                @(lang == "en" 
                    ? "Find answers to your questions about FinanceManager features and how to use them." 
                    : "Hier finden Sie Antworten auf Ihre Fragen zu FinanceManager-Funktionen und deren Verwendung.")
            </p>
        </div>
    </div>

    <div class="row">
        <div class="col-12 mb-3">
            <div class="input-group input-group-lg">
                <input type="text" 
                       class="form-control" 
                       id="helpSearch" 
                       placeholder="@(lang == "en" ? "Search documentation..." : "Dokumentation durchsuchen...")"
                       aria-label="Search help">
                <button class="btn btn-primary" type="button" id="searchBtn">
                    🔍
                </button>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div id="searchResults" class="d-none">
                <!-- Search results will be inserted here -->
            </div>

            <div id="featureList">
                @if (documents.Count == 0)
                {
                    <div class="alert alert-warning">
                        @(lang == "en" ? "No documentation available." : "Keine Dokumentation verfügbar.")
                    </div>
                }
                else
                {
                    <div class="row">
                        @foreach (var document in documents)
                        {
                            <div class="col-md-6 col-lg-4 mb-3">
                                <a class="card feature-card feature-card-action h-100 text-decoration-none"
                                   href="@($"/help/view/{Uri.EscapeDataString(document.Id)}")">
                                    <div class="card-body">
                                        <h5 class="card-title">@document.Title</h5>
                                        <p class="card-text">@document.Excerpt</p>
                                    </div>
                                </a>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private IReadOnlyList<HelpSearchDocumentDto> documents = [];
    private string language = "de";

    protected override void OnInitialized()
    {
        language = CultureInfo.CurrentUICulture.Name.StartsWith("en", StringComparison.OrdinalIgnoreCase) ? "en" : "de";

        var docsPath = HelpDocumentPathResolver.GetHelpSourcePath(Environment);
        if (!Directory.Exists(docsPath))
        {
            documents = [];
            return;
        }

        var index = HelpSearchIndexBuilder.Build(docsPath, language, HelpAssetIntegrityValidator.IsTrustedHelpFile);
        documents = index?.Documents
            .Where(document =>
                !string.IsNullOrWhiteSpace(document.Id)
                && !string.IsNullOrWhiteSpace(document.Title)
                && HelpDocumentPathResolver.TryNormalizeHelpPath(document.Id, out _))
            .ToArray() ?? [];
    }
}
