@page "/change-password"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using FinanceManager.Shared.Dtos.Users
@inject FinanceManager.Shared.IApiClient Api
@inject Microsoft.Extensions.Localization.IStringLocalizer<FinanceManager.Web.Components.Pages.ChangePassword> Localizer

<PageTitle>@Localizer["PageTitle"]</PageTitle>

<h1>@Localizer["Heading"]</h1>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="error">@_error</div>
}

@if (_success)
{
    <div class="info">@Localizer["Msg_PasswordChanged"]</div>
}

<EditForm Model="_model" OnValidSubmit="SubmitAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div>
        <label for="change-password-current">@Localizer["Label_CurrentPassword"]</label>
        <InputText id="change-password-current" @bind-Value="_model.CurrentPassword" Type="password" autocomplete="current-password" />
        <ValidationMessage For="() => _model.CurrentPassword" />
    </div>
    <div>
        <label for="change-password-new">@Localizer["Label_NewPassword"]</label>
        <InputText id="change-password-new" @bind-Value="_model.NewPassword" Type="password" autocomplete="new-password" />
        <ValidationMessage For="() => _model.NewPassword" />
    </div>
    <div>
        <label for="change-password-confirm">@Localizer["Label_ConfirmPassword"]</label>
        <InputText id="change-password-confirm" @bind-Value="_model.ConfirmPassword" Type="password" autocomplete="new-password" />
        <ValidationMessage For="() => _model.ConfirmPassword" />
    </div>
    <div style="margin-top:1.25rem;">
        <button type="submit" disabled="@_busy">
            @(_busy ? Localizer["Button_Wait"] : Localizer["Button_ChangePassword"])
        </button>
    </div>
</EditForm>

@code {
    private readonly ChangePasswordVm _model = new();
    private bool _busy;
    private bool _success;
    private string? _error;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        _success = false;
        try
        {
            var ok = await Api.UserSettings_ChangePasswordAsync(new ChangePasswordRequest(_model.CurrentPassword, _model.NewPassword), CancellationToken.None);
            if (ok)
            {
                _success = true;
            }
            else
            {
                _error = string.IsNullOrWhiteSpace(Api.LastError)
                    ? Localizer["Error_ChangeFailed"]
                    : Api.LastError;
            }
        }
        catch (Exception ex)
        {
            _error = string.Format(Localizer["Error_Unexpected"], ex.Message);
        }
        _busy = false;
    }

    private sealed class ChangePasswordVm
    {
        [Required]
        public string CurrentPassword { get; set; } = string.Empty;

        [Required, MinLength(8)]
        public string NewPassword { get; set; } = string.Empty;

        [Required, Compare(nameof(NewPassword))]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
