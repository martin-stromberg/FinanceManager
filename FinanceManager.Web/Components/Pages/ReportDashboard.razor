                                                    {
                                                        <div style="width:20px;height:20px;border-radius:6px;border:1px dashed var(--border);display:flex;align-items:center;justify-content:center;color:var(--muted);">
                                                            <svg style="width:14px;height:14px;opacity:.6;"><use href="icons/sprite.svg#image" /></svg>
                                                        </div>
