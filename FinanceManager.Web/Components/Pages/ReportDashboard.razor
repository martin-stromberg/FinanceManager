                                                <button type="button" class="projection-info-btn" title="@Localizer["ProjectionDetails_Open"]" @onclick="() => OpenProjectionDetails(GetDisplayName(child), child.Amount, child.ProjectionAmount ?? 0m, child.ProjectionExpectedItems!, child.GroupKey, child.PeriodStart)">
