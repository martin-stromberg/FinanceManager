    private static string FormatPostingDescription(ReportPostingDto p)
    {
        var parts = new[] { p.Subject, p.Description }
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Select(value => value!.Trim())
            .Distinct(StringComparer.Ordinal)
            .ToList();
        return parts.Count == 0 ? (string.IsNullOrWhiteSpace(p.RecipientName) ? "-" : p.RecipientName.Trim()) : string.Join(" – ", parts);
    }

