                                            </td>
                                            @if(ShowCategoryColumn){<td></td>}
                                            @if(ShowPreviousColumns){<td class="amt-prev" style="text-align:right;"><span>@(grand.PreviousAmount.HasValue? grand.PreviousAmount.Value.ToString("N2") : "-")</span>@if(grand.PreviousAmount.HasValue){<button type="button" class="icon-btn small" title="@Localizer["Postings_Open"]" @onclick="() => ShowCellPostingsAsync(grand, ReportPostingsPeriod.Previous)"><svg><use href="icons/sprite.svg#search" /></svg></button>}</td><td class="delta amt-prev" style="text-align:right;">@FormatDelta(grand.Amount, grand.PreviousAmount)</td>}
                                            @if(_compareYear){<td class="amt-year" style="text-align:right;"><span>@(grand.YearAgoAmount.HasValue? grand.YearAgoAmount.Value.ToString("N2") : "-")</span>@if(grand.YearAgoAmount.HasValue){<button type="button" class="icon-btn small" title="@Localizer["Postings_Open"]" @onclick="() => ShowCellPostingsAsync(grand, ReportPostingsPeriod.YearAgo)"><svg><use href="icons/sprite.svg#search" /></svg></button>}</td><td class="delta amt-year" style="text-align:right;">@FormatDelta(grand.Amount, grand.YearAgoAmount)</td>}
                                            <td class="amt-current" style="text-align:right;"><span>@grand.Amount.ToString("N2")</span><button type="button" class="icon-btn small" title="@Localizer["Postings_Open"]" @onclick="() => ShowCellPostingsAsync(grand, ReportPostingsPeriod.Current)"><svg><use href="icons/sprite.svg#search" /></svg></button></td>
                                            @if(ShowProjectionColumn)
                                            {
                                                <td class="amt-projection projection-cell" style="text-align:right;">
                                                    <span>@(grand.ProjectionAmount.HasValue ? grand.ProjectionAmount.Value.ToString("N2") : "-")</span>
                                                    @if (grand.ProjectionExpectedItems is { Count: > 0 })
                                                    {
                                                        <button type="button" class="projection-info-btn" title="@Localizer["ProjectionDetails_Open"]" @onclick="() => OpenProjectionDetails(GetDisplayName(grand), grand.Amount, grand.ProjectionAmount ?? 0m, grand.ProjectionExpectedItems!, grand.GroupKey, grand.PeriodStart)">
                                                            <svg><use href="icons/sprite.svg#info" /></svg>
                                                        </button>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                }
                            }
                        }
                        }
                        @if(_vm!.GetTopLevelRows().Any())
                        {
                            var totals = _vm!.GetTotals();
                            var totalProjectionDetails = GetTotalProjectionDetails();
                            var totalLabel = Localizer["Total_Label"].Value;
                             <tr class="total-row">
                                <td></td>
                                <td>@totalLabel</td>
                                @if(_vm!.ShowCategoryColumn){<td></td>}
                                @if(_vm!.ShowPreviousColumns){<td class="amt-prev" style="text-align:right;"><span>@(totals.Prev.HasValue ? totals.Prev.Value.ToString("N2") : "-")</span>@if(totals.Prev.HasValue){<button type="button" class="icon-btn small" title="@Localizer["Postings_Open"]" @onclick="() => ShowTotalPostingsAsync(ReportPostingsPeriod.Previous)"><svg><use href="icons/sprite.svg#search" /></svg></button>}</td><td class="delta amt-prev" style="text-align:right;">@(totals.Prev.HasValue ? FormatDelta(totals.Amount, totals.Prev) : "-")</td>}
                                @if(_compareYear){<td class="amt-year" style="text-align:right;"><span>@(totals.Year.HasValue ? totals.Year.Value.ToString("N2") : "-")</span>@if(totals.Year.HasValue){<button type="button" class="icon-btn small" title="@Localizer["Postings_Open"]" @onclick="() => ShowTotalPostingsAsync(ReportPostingsPeriod.YearAgo)"><svg><use href="icons/sprite.svg#search" /></svg></button>}</td><td class="delta amt-year" style="text-align:right;">@(totals.Year.HasValue ? FormatDelta(totals.Amount, totals.Year) : "-")</td>}
                                <td class="amt-current" style="text-align:right;"><span>@totals.Amount.ToString("N2")</span><button type="button" class="icon-btn small" title="@Localizer["Postings_Open"]" @onclick="() => ShowTotalPostingsAsync(ReportPostingsPeriod.Current)"><svg><use href="icons/sprite.svg#search" /></svg></button></td>
                                @if(ShowProjectionColumn)
                                {
                                    <td class="amt-projection projection-cell" style="text-align:right;">
                                        <span>@(totals.Projection.HasValue ? totals.Projection.Value.ToString("N2") : "-")</span>
                                        @if (totalProjectionDetails.Count > 0)
                                        {
                                            <button type="button" class="projection-info-btn" title="@Localizer["ProjectionDetails_Open"]" @onclick="() => OpenProjectionDetails(totalLabel, totals.Amount, totals.Projection ?? 0m, totalProjectionDetails)">
                                                <svg><use href="icons/sprite.svg#info" /></svg>
                                            </button>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            </div>
        }
    </div>
}
