@code {
    [Parameter, SupplyParameterFromQuery] public Guid? FavoriteId { get; set; }
    [Parameter, SupplyParameterFromQuery] public bool? Edit { get; set; }

    private enum TabId { Dashboard }

    private ReportDashboardViewModel? _vm;

    // State
    private bool _loaded;
    private bool _editMode;

    // Symbol mappings for report rows
    private readonly Dictionary<Guid, Guid?> _contactDisplaySymbolById = new();
    private readonly Dictionary<Guid, Guid?> _savingsDisplaySymbolById = new();
    private readonly Dictionary<Guid, Guid?> _securityDisplaySymbolById = new();
    private readonly Dictionary<Guid, Guid?> _contactCategorySymbolById = new();
    private readonly Dictionary<Guid, Guid?> _savingsCategorySymbolById = new();
    private readonly Dictionary<Guid, Guid?> _securityCategorySymbolById = new();
    private readonly Dictionary<string, Guid?> _contactCategorySymbolByName = new();
    private readonly Dictionary<string, Guid?> _savingsCategorySymbolByName = new();
    private readonly Dictionary<string, Guid?> _securityCategorySymbolByName = new();

    private List<PostingKind> _selectedKinds = new() { PostingKind.Bank }; // multi selection
    private ReportInterval _interval = ReportInterval.Month;
    private bool _includeCategory;
    private bool _comparePrevious;
    private bool _compareYear;
    private bool _compareProjection;
    private bool _showChart = true;
    private ReportChartType _chartType = ReportChartType.HistoricalSum;
    private ReportChartPosition _chartPosition = ReportChartPosition.AboveTable;
    private int _take = 24;
    private bool _includeDividendRelated; // new

    private bool _useValutaDate; // new: whether to use valuta date for analysis
    private bool _savingsPlanLinkedPostings; // new: use linked account postings as source for savings plans
    private string? _projectionDetailsTitle;
    private decimal _projectionDetailsActualAmount;
    private decimal _projectionDetailsExpectedAmount;
    private decimal _projectionDetailsAmount;
    private string? _projectionDetailsGroupKey;
    private DateTime? _projectionDetailsPeriodStart;
    private IReadOnlyList<ReportProjectionExpectedItemDto> _projectionDetails = Array.Empty<ReportProjectionExpectedItemDto>();
    private IReadOnlyList<ReportSuppressedExpectationDto> _suppressedExpectations = Array.Empty<ReportSuppressedExpectationDto>();
    private bool _projectionMutationBusy;

    private readonly PostingKind[] _postingKindValues = new[]{ PostingKind.Bank, PostingKind.Contact, PostingKind.SavingsPlan, PostingKind.Security };
    private static readonly string[] PieColors = new[] { "#2563eb", "#dc2626", "#16a34a", "#d97706", "#7c3aed", "#0891b2", "#db2777", "#65a30d", "#9333ea", "#64748b" };
    private sealed record PieSlice(string Label, decimal Amount, string Color);

    private IReadOnlyList<PieSlice> GetPieSlices()
    {
        var items = _vm!.GetTopLevelRows()
            .Select(p => (Label: GetDisplayName(p), Amount: Math.Abs(p.Amount)))
            .OrderByDescending(x => x.Amount)
            .ToList();
        if (items.Count > PieColors.Length)
        {
            items = items.Take(PieColors.Length - 1)
                .Append((Label: Localizer["Chart_Other"].Value, Amount: items.Skip(PieColors.Length - 1).Sum(x => x.Amount)))
                .ToList();
        }
        return items.Select((x, i) => new PieSlice(x.Label, x.Amount, PieColors[i % PieColors.Length])).ToList();
    }

    private static string BuildPieGradient(IReadOnlyList<PieSlice> slices)
    {
        var total = slices.Sum(x => x.Amount);
        if (total <= 0m) { return "conic-gradient(#64748b 0deg 360deg)"; }
        var parts = new List<string>();
        var start = 0m;
        foreach (var slice in slices)
        {
            var end = start + (slice.Amount * 360m / total);
            parts.Add($"{slice.Color} {start.ToString("0.###", CultureInfo.InvariantCulture)}deg {end.ToString("0.###", CultureInfo.InvariantCulture)}deg");
            start = end;
        }
        return $"conic-gradient({string.Join(", ", parts)})";
    }

    private bool IsMulti => _selectedKinds.Count > 1;
    private PostingKind PrimaryKind => _selectedKinds.First();
    private bool IsCategorySupported(PostingKind kind) => kind == PostingKind.Contact || kind == PostingKind.SavingsPlan || kind == PostingKind.Security;
    private bool IsCategoryGroupingSingle => !IsMulti && _includeCategory && IsCategorySupported(PrimaryKind);
    private bool ShowCategoryColumn => _includeCategory && !IsCategoryGroupingSingle;
    private bool ShowPreviousColumns => _comparePrevious && _interval is not ReportInterval.Year and not ReportInterval.Ytd;
    private bool CanCompareProjection => _selectedKinds.Count > 0 && _interval != ReportInterval.AllHistory;
    private bool ShowProjectionColumn => _vm?.ShowProjectionColumn == true || (_compareProjection && CanCompareProjection);
    private string PreviousHeaderLabel => Localizer["Th_Prev"];
    private string YearHeaderLabel => Localizer["Th_YearAgo"];

    private IReadOnlyList<ReportProjectionExpectedItemDto> GetTotalProjectionDetails()
    {
        if (_vm is null)
        {
            return Array.Empty<ReportProjectionExpectedItemDto>();
        }

        return _vm.GetTopLevelRows()
            .Where(p => p.ProjectionExpectedItems is { Count: > 0 })
            .SelectMany(p => p.ProjectionExpectedItems!)
            .OrderBy(p => p.ExpectedDate)
            .ThenBy(p => p.EntityName)
            .ToList();
    }

    private void OpenProjectionDetails(string title, decimal actualAmount, decimal projectionAmount, IReadOnlyList<ReportProjectionExpectedItemDto> details, string? groupKey = null, DateTime? periodStart = null)
    {
        _projectionDetailsTitle = string.Format(System.Globalization.CultureInfo.CurrentCulture, Localizer["ProjectionDetails_Title"].Value, title);
        _projectionDetailsActualAmount = actualAmount;
        _projectionDetailsAmount = projectionAmount;
        _projectionDetailsGroupKey = groupKey;
        _projectionDetailsPeriodStart = periodStart;
        _projectionDetails = details
            .OrderBy(p => p.ExpectedDate)
            .ThenBy(p => p.EntityName)
            .ToList();
        _projectionDetailsExpectedAmount = _projectionDetails.Sum(p => p.Amount);
        _ = LoadSuppressedExpectationsAsync();
    }

    private void CloseProjectionDetails()
    {
        _projectionDetailsTitle = null;
        _projectionDetailsActualAmount = 0m;
        _projectionDetailsExpectedAmount = 0m;
        _projectionDetailsAmount = 0m;
        _projectionDetailsGroupKey = null;
        _projectionDetailsPeriodStart = null;
        _projectionDetails = Array.Empty<ReportProjectionExpectedItemDto>();
        _suppressedExpectations = Array.Empty<ReportSuppressedExpectationDto>();
    }

    private async Task LoadSuppressedExpectationsAsync()
    {
        if (_vm?.ActiveFavoriteId is not { } favoriteId)
        {
            _suppressedExpectations = Array.Empty<ReportSuppressedExpectationDto>();
            return;
        }
        try
        {
            var all = await Api.Reports_ListSuppressedExpectationsAsync(favoriteId);
            var scope = GetSuppressedExpectationScope();
            _suppressedExpectations = scope is null
                ? all
                : all.Where(item => scope.Contains((item.Kind, item.EntityId))).ToList();
        }
        catch
        {
            _suppressedExpectations = Array.Empty<ReportSuppressedExpectationDto>();
        }
        await InvokeAsync(StateHasChanged);
    }

    private IReadOnlySet<(PostingKind Kind, Guid EntityId)>? GetSuppressedExpectationScope()
    {
        if (_projectionDetailsGroupKey is null)
        {
            return null;
        }
        if (TryGetProjectionEntityScope(_projectionDetailsGroupKey, out var entityScope))
        {
            return new HashSet<(PostingKind, Guid)> { entityScope };
        }
        var descendants = CollectProjectionEntityScope(_projectionDetailsGroupKey);
        return descendants.Count == 0
            ? _projectionDetails.Select(item => (item.Kind, item.EntityId)).ToHashSet()
            : descendants;
    }

    private HashSet<(PostingKind Kind, Guid EntityId)> CollectProjectionEntityScope(string groupKey)
    {
        var result = new HashSet<(PostingKind, Guid)>();
        if (_vm is null)
        {
            return result;
        }
        var periodPoints = _vm.Points
            .Where(point => _projectionDetailsPeriodStart is null || point.PeriodStart == _projectionDetailsPeriodStart.Value)
            .ToList();
        var pending = new Queue<string>();
        pending.Enqueue(groupKey);
        var visited = new HashSet<string> { groupKey };
        while (pending.Count > 0)
        {
            var parent = pending.Dequeue();
            foreach (var child in periodPoints.Where(point => point.ParentGroupKey == parent))
            {
                if (!visited.Add(child.GroupKey))
                {
                    continue;
                }
                if (TryGetProjectionEntityScope(child.GroupKey, out var childScope))
                {
                    result.Add(childScope);
                }
                pending.Enqueue(child.GroupKey);
            }
        }
        return result;
    }

    private static bool TryGetProjectionEntityScope(string groupKey, out (PostingKind Kind, Guid EntityId) scope)
    {
        scope = default;
        var parts = groupKey.Split(':');
        if (parts.Length < 2 || !Guid.TryParse(parts[1], out var entityId))
        {
            return false;
        }
        var kind = parts[0] switch
        {
            "Account" => PostingKind.Bank,
            "Contact" => PostingKind.Contact,
            "SavingsPlan" => PostingKind.SavingsPlan,
            "Security" => PostingKind.Security,
            _ => (PostingKind?)null
        };
        if (kind is null)
        {
            return false;
        }
        scope = (kind.Value, entityId);
        return true;
    }

    private async Task SuppressExpectationAsync(ReportProjectionExpectedItemDto item)
    {
        if (_vm?.ActiveFavoriteId is not { } favoriteId || _projectionMutationBusy) { return; }
        _projectionMutationBusy = true;
        try
        {
            var created = await Api.Reports_SuppressExpectationAsync(favoriteId,
                new ReportSuppressedExpectationRequest(item.Kind, item.EntityId, item.PriorYearDate, item.PostingId, item.Amount));
            if (created is null) { return; }
            _projectionDetails = _projectionDetails
                .Where(p => !(p.Kind == item.Kind
                    && p.EntityId == item.EntityId
                    && p.PriorYearDate == item.PriorYearDate
                    && (item.PostingId is null || p.PostingId == item.PostingId)))
                .ToList();
            _projectionDetailsExpectedAmount = _projectionDetails.Sum(p => p.Amount);
            _projectionDetailsAmount = _projectionDetailsActualAmount + _projectionDetailsExpectedAmount;
            await LoadSuppressedExpectationsAsync();
            await LoadAsync();
        }
        finally
        {
            _projectionMutationBusy = false;
        }
    }

    private async Task UnsuppressExpectationAsync(ReportSuppressedExpectationDto item)
    {
        if (_vm?.ActiveFavoriteId is not { } favoriteId || _projectionMutationBusy) { return; }
        _projectionMutationBusy = true;
        try
        {
            var ok = await Api.Reports_UnsuppressExpectationAsync(favoriteId, item.Id);
            if (!ok) { return; }
            _suppressedExpectations = _suppressedExpectations.Where(s => s.Id != item.Id).ToList();
            await LoadAsync();
            RefreshProjectionDetailsFromLoadedPoints();
            await LoadSuppressedExpectationsAsync();
        }
        finally
        {
            _projectionMutationBusy = false;
        }
    }

    private void RefreshProjectionDetailsFromLoadedPoints()
    {
        if (_vm is null)
        {
            return;
        }
        if (_projectionDetailsGroupKey is null)
        {
            var totals = _vm.GetTotals();
            _projectionDetails = GetTotalProjectionDetails();
            _projectionDetailsActualAmount = totals.Amount;
            _projectionDetailsExpectedAmount = _projectionDetails.Sum(item => item.Amount);
            _projectionDetailsAmount = totals.Projection ?? totals.Amount + _projectionDetailsExpectedAmount;
            return;
        }
        var point = _vm.Points.FirstOrDefault(p =>
            p.GroupKey == _projectionDetailsGroupKey
            && (_projectionDetailsPeriodStart is null || p.PeriodStart == _projectionDetailsPeriodStart.Value));
        _projectionDetails = point?.ProjectionExpectedItems?
            .OrderBy(p => p.ExpectedDate)
            .ThenBy(p => p.EntityName)
            .ToList() ?? new List<ReportProjectionExpectedItemDto>();
        _projectionDetailsActualAmount = point?.Amount ?? 0m;
        _projectionDetailsExpectedAmount = _projectionDetails.Sum(p => p.Amount);
        _projectionDetailsAmount = point?.ProjectionAmount ?? _projectionDetailsActualAmount + _projectionDetailsExpectedAmount;
    }

