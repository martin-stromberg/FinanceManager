@page "/reports/dashboard"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using System.Globalization
@using System.Web
@using FinanceManager.Domain
@using FinanceManager.Domain.Reports
@using FinanceManager.Shared.Dtos
@using FinanceManager.Shared.Dtos.Postings
@using FinanceManager.Shared.Dtos.Reports
@using FinanceManager.Shared.Dtos.SavingsPlans
@using FinanceManager.Shared.Dtos.Securities
@using FinanceManager.Web.ViewModels.Common
@using FinanceManager.Web.ViewModels.Reports
@using FinanceManager.Web.Services
@inject NavigationManager Nav
@inject HttpClient Http
@inject IServiceProvider Services
@inject Microsoft.Extensions.Localization.IStringLocalizer<FinanceManager.Web.Components.Pages.ReportDashboard> Localizer
@inject FinanceManager.Shared.IApiClient Api
@inject IConfirmationService ConfirmationService
@using FinanceManager.Web.Components.Shared
@using Microsoft.AspNetCore.Components
@using FinanceManager.Web.ViewModels

<PageTitle>@((_vm?.ActiveFavoriteId.HasValue ?? false) && !string.IsNullOrWhiteSpace(_vm?.FavoriteName) ? _vm!.FavoriteName : Localizer["PageTitle"])</PageTitle>

<Ribbon TTabEnum="ReportDashboard.TabId" Provider="_vm" Localizer="Localizer" />

<ConfirmationDialogHost />

<div class="report-dashboard-page">
    <h2 class="report-dashboard-heading">@(string.IsNullOrWhiteSpace(_vm?.FavoriteName) ? Localizer["Heading"] : _vm!.FavoriteName.Trim())</h2>

    @if(!_loaded)
    {
        <p>@Localizer["Loading"]</p>
    }
    else
    {
    @if(_editMode)
    {
        <div class="filters-panel">
            <div class="filter-group wide">
                <div class="group-title">@Localizer["FilterGroup_Data"]</div>
                <div class="row">
                    <label>@Localizer["Label_PostingKindMulti"]</label>
                    <div class="multi-kind-list">
                        @foreach(var kind in _postingKindValues)
                        {
                            var v = kind;
                            var checkedAttr = _selectedKinds.Contains(v);
                            // The last selected kind cannot be deselected; disabling makes the
                            // enforced minimum visible instead of a click that silently reverts.
                            var disabledAttr = checkedAttr && _selectedKinds.Count == 1;
                            var titleAttr = disabledAttr ? Localizer["Hint_PostingKindRequired"].Value : null;
                            var label = Localizer[$"PostingKind_{kind}"];
                            <label class="mk-item" title="@titleAttr"><input type="checkbox" value="@v" checked="@checkedAttr" disabled="@disabledAttr" @onchange="e => OnToggleKind(v, e.Value is bool b && b)" /> @label</label>
                        }
                    </div>
                </div>
                <div class="row">
                    <label>@Localizer["Label_Interval"]</label>
                    <select @bind="_interval" @bind:after="StateHasChanged">
                        @foreach (var iv in Enum.GetValues<ReportInterval>())
                        {
                            var label = Localizer[$"Interval_{iv}"];
                            <option value="@iv">@label</option>
                        }
                    </select>
                </div>
                <div class="row inline month-row">
                    <label>@Localizer["Label_AnalysisMonth"]</label>
                    <button type="button" class="icon-btn small" title="@Localizer["Button_PrevMonth"]" @onclick="PrevMonth"><svg><use href="icons/sprite.svg#chevron-left"/></svg></button>
                    <input type="month" value="@_analysisMonthString" @onchange="OnAnalysisMonthChange" />
                    <button type="button" class="icon-btn small" title="@Localizer["Button_NextMonth"]" @onclick="NextMonth"><svg><use href="icons/sprite.svg#chevron-right"/></svg></button>
                </div>
                <div class="row inline">
                    <label class="chk"><input type="checkbox" @bind="_includeCategory" @bind:after="OnIncludeCategoryChanged" /> @Localizer["Label_IncludeCategory"]</label>
                    <label class="take-label">@Localizer["Label_Take"] <input type="number" min="1" max="120" @bind="_take" class="take-input" /></label>
                    <label class="chk" style="margin-left:1rem;"><input type="checkbox" @bind="_includeDividendRelated" @bind:after="OnIncludeDividendRelatedChanged" /> @Localizer["Label_IncludeDividendRelated"]</label>
                </div>
                <div class="row inline" style="margin-top:.5rem;align-items:center;">
                    <label style="margin-right:.5rem;">@Localizer["Label_DateKind"]</label>
                    <select value="@_dateKindString" @onchange="OnDateKindChange">
                        <option value="booking">@Localizer["DateKind_Booking"]</option>
                        <option value="valuta">@Localizer["DateKind_Valuta"]</option>
                    </select>
                </div>
                @if (_selectedKinds.Contains(PostingKind.SavingsPlan))
                {
                    <div class="row inline" style="margin-top:.5rem;align-items:center;">
                        <label style="margin-right:.5rem;">@Localizer["Label_SavingsPlanPostingSource"]</label>
                        <select value="@_savingsPlanPostingSourceString" @onchange="OnSavingsPlanPostingSourceChange">
                            <option value="plan">@Localizer["SavingsPlanPostingSource_PlanPostings"]</option>
                            <option value="linked">@Localizer["SavingsPlanPostingSource_LinkedAccountPostings"]</option>
                        </select>
                    </div>
                }
            </div>
            <div class="filter-group">
                <div class="group-title">@Localizer["FilterGroup_Comparisons"]</div>
                <div class="row chk"><label><input type="checkbox" @bind="_comparePrevious" disabled="@(_interval == ReportInterval.AllHistory)" /> @Localizer["Label_ComparePrev"]</label></div>
                <div class="row chk"><label><input type="checkbox" @bind="_compareYear" disabled="@(_interval == ReportInterval.AllHistory)" /> @Localizer["Label_CompareYear"]</label></div>
                <div class="row chk"><label><input type="checkbox" @bind="_compareProjection" disabled="@(!CanCompareProjection)" /> @Localizer["Label_CompareProjection"]</label></div>
            </div>
            <div class="filter-group">
                <div class="group-title">@Localizer["FilterGroup_Chart"]</div>
                <div class="row chk"><label><input type="checkbox" @bind="_showChart" disabled="@(_interval == ReportInterval.AllHistory)" /> @Localizer["Label_ShowChart"]</label></div>
                <div class="row"><label>@Localizer["Label_ChartType"] <select @bind="_chartType" disabled="@(!_showChart || _interval == ReportInterval.AllHistory)"><option value="@ReportChartType.HistoricalSum">@Localizer["ChartType_HistoricalSum"]</option><option value="@ReportChartType.Allocation">@Localizer["ChartType_Allocation"]</option><option value="@ReportChartType.Pie">@Localizer["ChartType_Pie"]</option></select></label></div>
                <div class="row"><label>@Localizer["Label_ChartPosition"] <select @bind="_chartPosition" disabled="@(!_showChart || _interval == ReportInterval.AllHistory)"><option value="@ReportChartPosition.AboveTable">@Localizer["ChartPosition_AboveTable"]</option><option value="@ReportChartPosition.BelowTable">@Localizer["ChartPosition_BelowTable"]</option></select></label></div>
            </div>
        </div>
    }

    <div class="result-box">
        @if(_projectionDetailsTitle is not null)
        {
            <div class="modal-overlay projection-detail-overlay" role="dialog" aria-modal="true" aria-labelledby="projection-detail-title">
                <div class="modal projection-detail-modal">
                    <div class="projection-detail-header">
                        <h3 id="projection-detail-title">@_projectionDetailsTitle</h3>
                        <button type="button" class="icon-btn small" title="@Localizer["Button_Close"]" @onclick="CloseProjectionDetails">
                            <svg><use href="icons/sprite.svg#close" /></svg>
                        </button>
                    </div>
                    <div class="projection-detail-summary">
                        <div class="projection-detail-summary-row projection-detail-summary-muted">
                            <span>@Localizer["ProjectionDetails_ActualAmount"]</span>
                            <strong>@_projectionDetailsActualAmount.ToString("N2")</strong>
                        </div>
                        <div class="projection-detail-summary-row">
                            <span>@Localizer["ProjectionDetails_ExpectedAmount"]</span>
                            <strong>@_projectionDetailsExpectedAmount.ToString("N2")</strong>
                        </div>
                        <div class="projection-detail-summary-row projection-detail-summary-total">
                            <span>@Localizer["ProjectionDetails_ProjectionAmount"]</span>
                            <strong>@_projectionDetailsAmount.ToString("N2")</strong>
                        </div>
                    </div>
                    @if(_projectionDetails.Count == 0)
                    {
                        <div class="small-empty">@Localizer["ProjectionDetails_None"]</div>
                    }
                    else
                    {
                        <table class="fm-table projection-detail-table">
                            <thead>
                                <tr>
                                    <th>@Localizer["ProjectionDetails_Kind"]</th>
                                    <th>@Localizer["ProjectionDetails_Entity"]</th>
                                    <th>@Localizer["ProjectionDetails_ExpectedDate"]</th>
                                    <th>@Localizer["ProjectionDetails_PriorYearDate"]</th>
                                    <th style="text-align:right;">@Localizer["ProjectionDetails_Amount"]</th>
                                    @if(_vm?.ActiveFavoriteId is not null)
                                    {
                                        <th></th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach(var item in _projectionDetails)
                                {
                                    <tr>
                                        <td>@Localizer[$"PostingKind_{item.Kind}"]</td>
                                        <td>@item.EntityName</td>
                                        <td>@item.ExpectedDate.ToString("d")</td>
                                        <td>@item.PriorYearDate.ToString("d")</td>
                                        <td style="text-align:right;">@item.Amount.ToString("N2")</td>
                                        @if(_vm?.ActiveFavoriteId is not null)
                                        {
                                            <td>
                                                <button type="button" class="btn secondary projection-suppress-btn" disabled="@(_projectionMutationBusy || _vm?.IsBusy == true)" @onclick="() => SuppressExpectationAsync(item)">
                                                    @Localizer["ProjectionDetails_Suppress"]
                                                </button>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    @if(_vm?.ActiveFavoriteId is not null)
                    {
                        <h4 class="projection-suppressed-title">@Localizer["ProjectionDetails_Suppressed_Title"]</h4>
                        @if(_suppressedExpectations.Count == 0)
                        {
                            <div class="small-empty">@Localizer["ProjectionDetails_Suppressed_None"]</div>
                        }
                        else
                        {
                            <table class="fm-table projection-detail-table projection-suppressed-table">
                                <thead>
                                    <tr>
                                        <th>@Localizer["ProjectionDetails_Kind"]</th>
                                        <th>@Localizer["ProjectionDetails_Entity"]</th>
                                        <th>@Localizer["ProjectionDetails_ExpectedDate"]</th>
                                        <th>@Localizer["ProjectionDetails_PriorYearDate"]</th>
                                        <th style="text-align:right;">@Localizer["ProjectionDetails_Amount"]</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach(var item in _suppressedExpectations)
                                    {
                                        <tr>
                                            <td>@Localizer[$"PostingKind_{item.Kind}"]</td>
                                            <td>@item.EntityName</td>
                                            <td>@item.ExpectedDate.ToString("d")</td>
                                            <td>@item.PriorYearDate.ToString("d")</td>
                                            <td style="text-align:right;">@(item.Amount?.ToString("N2") ?? "-")</td>
                                            <td>
                                                <button type="button" class="btn secondary projection-unsuppress-btn" disabled="@(_projectionMutationBusy || _vm?.IsBusy == true)" @onclick="() => UnsuppressExpectationAsync(item)">
                                                    @Localizer["ProjectionDetails_Unsuppress"]
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    }
                </div>
            </div>
        }
        @if(_vm?.PostingsOverlayVisible == true)
        {
            <div class="modal-overlay" @onclick="(()=> _vm!.HidePostings())">
                <div class="modal postings-modal" role="dialog" aria-modal="true" @onclick:stopPropagation>
                    <div class="projection-detail-header">
                        <h3>@_vm!.PostingsOverlayTitle</h3>
                        <button type="button" class="icon-btn small" title="@Localizer["Button_Close"]" @onclick="(()=> _vm!.HidePostings())">
                            <svg><use href="icons/sprite.svg#close" /></svg>
                        </button>
                    </div>
                    @if(_vm!.PostingsOverlayLoading)
                    {
                        <div class="small-empty">@Localizer["Loading"]</div>
                    }
                    else if(_vm!.PostingsOverlayFailed)
                    {
                        <div class="small-empty">@(_vm!.PostingsOverlayError ?? Localizer["Postings_LoadFailed"].Value)</div>
                    }
                    else if(_vm!.PostingsOverlayRows.Count == 0)
                    {
                        <div class="small-empty">@Localizer["Postings_None"]</div>
                    }
                    else
                    {
                        <table class="fm-table postings-table">
                            <thead>
                                <tr>
                                    <th>@Localizer["Postings_Th_Date"]</th>
                                    <th>@Localizer["Postings_Th_Origin"]</th>
                                    <th>@Localizer["Postings_Th_Description"]</th>
                                    <th style="text-align:right;">@Localizer["Postings_Th_Amount"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach(var p in _vm!.PostingsOverlayRows)
                                {
                                    <tr>
                                        <td>@GetPostingEffectiveDate(p).ToString("d")</td>
                                        <td>@p.EntityName</td>
                                        <td>@FormatPostingDescription(p)</td>
                                        <td style="text-align:right;">@p.Amount.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3" style="font-weight:600;">@Localizer["Postings_Total"]</td>
                                    <td style="text-align:right;font-weight:600;">@_vm!.PostingsOverlayTotalAmount.ToString("N2")</td>
                                </tr>
                            </tfoot>
                        </table>
                        @if(_vm!.PostingsOverlayTruncated)
                        {
                            <div class="small-empty">@Localizer["Postings_Truncated"]</div>
                        }
                    }
                </div>
            </div>
        }
        @if(_vm?.IsBusy == true)
        {
            <div class="query-overlay">@Localizer["Loading"]</div>
        }
        @if(!(_vm?.IsBusy ?? false) && (_vm?.Points.Count ?? 0) == 0)
        {
            <div class="empty-info">@Localizer["NoData"]</div>
        }
        else if((_vm?.Points.Count ?? 0) > 0)
        {
            <div class="report-chart-layout @(_chartPosition == ReportChartPosition.BelowTable ? "chart-below" : string.Empty)">
            @if(_showChart && _interval != ReportInterval.AllHistory)
            {
                <div class="mini-chart" aria-label="@Localizer["Aria_Chart"]">
                    @if (_chartType == ReportChartType.HistoricalSum)
                    {
                        var byPeriod = _vm!.GetChartByPeriod();
                        var max = byPeriod.Select(x=>Math.Abs(x.Sum)).DefaultIfEmpty(0m).Max();
                        var scale = max==0?0:70m/max;
                        <div class="bars">
                            @foreach(var bp in byPeriod)
                            {
                                var h = bp.Sum>0 ? (int)Math.Round((double)(bp.Sum*scale)) : (int)Math.Round((double)(-bp.Sum*scale));
                                <div class="bar-wrap" title="@bp.PeriodStart.ToString("yyyy-MM-dd") @bp.Sum">
                                    <div class="bar-inner @(bp.Sum>=0?"pos":"neg")" style="height:@(h)px"></div>
                                </div>
                            }
                        </div>
                    }
                    else if (_chartType == ReportChartType.Allocation)
                    {
                        var entities = _vm!.GetTopLevelRows().ToList();
                        var max = entities.Select(x=>Math.Abs(x.Amount)).DefaultIfEmpty(0m).Max();
                        <div class="allocation-chart">
                            @foreach(var item in entities)
                            {
                                var width = max == 0m ? 0 : (int)Math.Round((double)(Math.Abs(item.Amount) * 100m / max));
                                <div class="allocation-item" title="@GetDisplayName(item) @item.Amount.ToString("N2")">
                                    <div class="allocation-label">@GetDisplayName(item)</div>
                                    <div class="allocation-track"><div class="allocation-bar @(item.Amount>=0?"pos":"neg")" style="width:@width%"></div></div>
                                    <div class="allocation-amount">@item.Amount.ToString("N2")</div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        var slices = GetPieSlices();
                        <div class="pie-chart">
                            <div class="pie" style="background:@BuildPieGradient(slices)"></div>
                            <div class="pie-legend">
                                @for (var i = 0; i < slices.Count; i++)
                                {
                                    <div class="pie-legend-item"><span class="pie-color" style="background:@PieColors[i % PieColors.Length]"></span><span>@slices[i].Label</span><strong>@slices[i].Amount.ToString("N2")</strong></div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            <div class="report-table-wrap table-responsive">
                <table class="fm-table report-table expandable">
                    <thead>
                        <tr>
                            <th style="width:24px;"></th>
                            <th>@Localizer["Th_Group"]</th>
                            @if(ShowCategoryColumn){<th>@Localizer["Th_Category"]</th>}
                            @if(ShowPreviousColumns){<th class="th-prev" style="text-align:right;">@PreviousHeaderLabel</th><th class="th-prev" style="text-align:right;">@Localizer["Th_DeltaPrev"]</th>}
                            @if(_compareYear){<th class="th-year" style="text-align:right;">@YearHeaderLabel</th><th class="th-year" style="text-align:right;">@Localizer["Th_DeltaYear"]</th>}
                            <th class="th-current" style="text-align:right;">@Localizer["Th_Amount"]</th>
                            @if(ShowProjectionColumn){<th class="th-projection" style="text-align:right;">@Localizer["Th_Projection"]</th>}
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var top in _vm!.GetTopLevelRows())
                        {
                            var rowClass = ReportDashboardViewModel.IsNegative(top) ? "neg" : string.Empty;
                            var hasChildren = _vm!.HasChildren(top.GroupKey);
                            var expanded = hasChildren && _vm!.IsExpanded(top.GroupKey);
                            <tr class="@rowClass @(top.GroupKey.StartsWith("Type:")?"type-row": (top.GroupKey.StartsWith("Category:")?"category-row":"entity-row"))">
                            <td>
                                @if(hasChildren)
                                {
                                    <button type="button" class="toggle-btn" @onclick="(()=>_vm!.ToggleExpanded(top.GroupKey))" title="@(expanded?Localizer["Collapse"]:Localizer["Expand"])" aria-expanded="@expanded">
                                        <svg class="ico"><use href="icons/sprite.svg#@(expanded?"chevron-down":"chevron-right")" /></svg>
                                    </button>
                                }
                            </td>
                            <td>
                                @{ var symTop = GetSymbolForPoint(top); }
                                <div style="display:flex;align-items:center;gap:.5rem;">
                                    @if (symTop != null)
                                    {
                                        <div style="width:24px;height:24px;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;overflow:hidden;border-radius:6px;">
                                            <img src="@($"/api/attachments/{symTop}/download")" alt="symbol" style="max-width:100%;max-height:100%;display:block;" />
                                        </div>
                                    }
                                    else
                                    {
                                        <div style="width:24px;height:24px;border-radius:6px;border:1px dashed var(--border);display:flex;align-items:center;justify-content:center;color:var(--muted);">
                                            <svg style="width:16px;height:16px;opacity:.6;"><use href="icons/sprite.svg#image" /></svg>
                                        </div>
                                    }
                                    <span>@GetDisplayName(top)</span>
                                </div>
                            </td>
                            @if(ShowCategoryColumn){<td>@(string.IsNullOrWhiteSpace(top.CategoryName)?"-":top.CategoryName)</td>}
                            @if(ShowPreviousColumns){<td class="amt-prev" style="text-align:right;"><span>@(top.PreviousAmount.HasValue? top.PreviousAmount.Value.ToString("N2") : "-")</span>@if(top.PreviousAmount.HasValue){<button type="button" class="icon-btn small" title="@Localizer["Postings_Open"]" @onclick="() => ShowCellPostingsAsync(top, ReportPostingsPeriod.Previous)"><svg><use href="icons/sprite.svg#search" /></svg></button>}</td><td class="delta amt-prev" style="text-align:right;">@FormatDelta(top.Amount, top.PreviousAmount)</td>}
                            @if(_compareYear){<td class="amt-year" style="text-align:right;"><span>@(top.YearAgoAmount.HasValue? top.YearAgoAmount.Value.ToString("N2") : "-")</span>@if(top.YearAgoAmount.HasValue){<button type="button" class="icon-btn small" title="@Localizer["Postings_Open"]" @onclick="() => ShowCellPostingsAsync(top, ReportPostingsPeriod.YearAgo)"><svg><use href="icons/sprite.svg#search" /></svg></button>}</td><td class="delta amt-year" style="text-align:right;">@FormatDelta(top.Amount, top.YearAgoAmount)</td>}
                            <td class="amt-current" style="text-align:right;"><span>@top.Amount.ToString("N2")</span><button type="button" class="icon-btn small" title="@Localizer["Postings_Open"]" @onclick="() => ShowCellPostingsAsync(top, ReportPostingsPeriod.Current)"><svg><use href="icons/sprite.svg#search" /></svg></button></td>
                            @if(ShowProjectionColumn)
                            {
                                <td class="amt-projection projection-cell" style="text-align:right;">
                                    <span>@(top.ProjectionAmount.HasValue ? top.ProjectionAmount.Value.ToString("N2") : "-")</span>
                                    @if (top.ProjectionExpectedItems is { Count: > 0 })
                                    {
                                        <button type="button" class="projection-info-btn" title="@Localizer["ProjectionDetails_Open"]" @onclick="() => OpenProjectionDetails(GetDisplayName(top), top.Amount, top.ProjectionAmount ?? 0m, top.ProjectionExpectedItems!, top.GroupKey, top.PeriodStart)">
                                            <svg><use href="icons/sprite.svg#info" /></svg>
                                        </button>
                                    }
                                </td>
                            }
                        </tr>
                        @if(hasChildren && expanded)
                        {
                            foreach(var child in _vm!.GetChildRows(top.GroupKey))
                            {
                                var childCls = ReportDashboardViewModel.IsNegative(child) ? "neg" : string.Empty;
                                var childHasChildren = _vm!.HasChildren(child.GroupKey);
                                var childExpanded = childHasChildren && _vm!.IsExpanded(child.GroupKey);
                                <tr class="child-row @childCls @(child.GroupKey.StartsWith("Category:")?"category-row":"entity-row")">
                                    <td>
                                        @if(childHasChildren)
                                        {
                                            <button type="button" class="toggle-btn" @onclick="(()=>_vm!.ToggleExpanded(child.GroupKey))" title="@(childExpanded?Localizer["Collapse"]:Localizer["Expand"])" aria-expanded="@childExpanded">
                                                <svg class="ico"><use href="icons/sprite.svg#@(childExpanded?"chevron-down":"chevron-right")" /></svg>
                                            </button>
                                        }
                                    </td>
                                    <td class="child-label">
                                        @{ var symChild = GetSymbolForPoint(child); }
                                        <div style="display:flex;align-items:center;gap:.5rem;">
                                            @if (symChild != null)
                                            {
                                                <div style="width:20px;height:20px;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;overflow:hidden;border-radius:6px;">
                                                    <img src="@($"/api/attachments/{symChild}/download")" alt="symbol" style="max-width:100%;max-height:100%;display:block;" />
                                                </div>
                                            }
                                            else
                                            {
                                                <div style="width:20px;height:20px;border-radius:6px;border:1px dashed var(--border);display:flex;align-items:center;justify-content:center;color:var(--muted);">
                                                    <svg style="width:14px;height:14px;opacity:.6;"><use href="icons/sprite.svg#image" /></svg>
                                                </div>
                                            }
                                            <span>@GetDisplayName(child)</span>
                                        </div>
                                    </td>
                                    @if(ShowCategoryColumn){<td>@(string.IsNullOrWhiteSpace(child.CategoryName)?"-":child.CategoryName)</td>}
                                    @if(ShowPreviousColumns){<td class="amt-prev" style="text-align:right;"><span>@(child.PreviousAmount.HasValue? child.PreviousAmount.Value.ToString("N2") : "-")</span>@if(child.PreviousAmount.HasValue){<button type="button" class="icon-btn small" title="@Localizer["Postings_Open"]" @onclick="() => ShowCellPostingsAsync(child, ReportPostingsPeriod.Previous)"><svg><use href="icons/sprite.svg#search" /></svg></button>}</td><td class="delta amt-prev" style="text-align:right;">@FormatDelta(child.Amount, child.PreviousAmount)</td>}
                                    @if(_compareYear){<td class="amt-year" style="text-align:right;"><span>@(child.YearAgoAmount.HasValue? child.YearAgoAmount.Value.ToString("N2") : "-")</span>@if(child.YearAgoAmount.HasValue){<button type="button" class="icon-btn small" title="@Localizer["Postings_Open"]" @onclick="() => ShowCellPostingsAsync(child, ReportPostingsPeriod.YearAgo)"><svg><use href="icons/sprite.svg#search" /></svg></button>}</td><td class="delta amt-year" style="text-align:right;">@FormatDelta(child.Amount, child.YearAgoAmount)</td>}
                                    <td class="amt-current" style="text-align:right;"><span>@child.Amount.ToString("N2")</span><button type="button" class="icon-btn small" title="@Localizer["Postings_Open"]" @onclick="() => ShowCellPostingsAsync(child, ReportPostingsPeriod.Current)"><svg><use href="icons/sprite.svg#search" /></svg></button></td>
                                    @if(ShowProjectionColumn)
                                    {
                                        <td class="amt-projection projection-cell" style="text-align:right;">
                                            <span>@(child.ProjectionAmount.HasValue ? child.ProjectionAmount.Value.ToString("N2") : "-")</span>
                                            @if (child.ProjectionExpectedItems is { Count: > 0 })
