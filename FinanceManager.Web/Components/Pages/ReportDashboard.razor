    private void ApplyFavorite(FinanceManager.Shared.Dtos.Reports.ReportFavoriteDto fav)
    {
        _vm!.ActiveFavoriteId = fav.Id;
        _vm!.FavoriteName = fav.Name;
        _vm!.FiltersDirty = false;
        CloseProjectionDetails();
        _selectedKinds = fav.PostingKinds?.Count > 0 ? fav.PostingKinds.Select(x => x).ToList() : new List<PostingKind> { fav.PostingKind };
        _includeCategory = fav.IncludeCategory;
        _includeDividendRelated = fav.Filters?.IncludeDividendRelated ?? false;
        _interval = (ReportInterval)fav.Interval;
        _take = fav.Take;
        _comparePrevious = fav.ComparePrevious;
        _compareYear = fav.CompareYear;
        _compareProjection = fav.CompareProjection && CanCompareProjection;
        _showChart = fav.ShowChart;
        _chartType = fav.ChartType;
        _chartPosition = fav.ChartPosition;
        _vm!.SelectedAccounts.Clear(); foreach (var id in fav.Filters?.AccountIds ?? Array.Empty<Guid>()) { _vm.SelectedAccounts.Add(id); }
        _vm!.SelectedContacts.Clear(); foreach (var id in fav.Filters?.ContactIds ?? Array.Empty<Guid>()) { _vm.SelectedContacts.Add(id); }
        _vm!.SelectedSavingsPlans.Clear(); foreach (var id in fav.Filters?.SavingsPlanIds ?? Array.Empty<Guid>()) { _vm.SelectedSavingsPlans.Add(id); }
        _vm!.SelectedSecurities.Clear(); foreach (var id in fav.Filters?.SecurityIds ?? Array.Empty<Guid>()) { _vm.SelectedSecurities.Add(id); }
        _vm!.SelectedContactCategories.Clear(); foreach (var id in fav.Filters?.ContactCategoryIds ?? Array.Empty<Guid>()) { _vm.SelectedContactCategories.Add(id); }
        _vm!.SelectedSavingsCategories.Clear(); foreach (var id in fav.Filters?.SavingsPlanCategoryIds ?? Array.Empty<Guid>()) { _vm.SelectedSavingsCategories.Add(id); }
        _vm!.SelectedSecurityCategories.Clear(); foreach (var id in fav.Filters?.SecurityCategoryIds ?? Array.Empty<Guid>()) { _vm.SelectedSecurityCategories.Add(id); }
        _vm!.SelectedSecuritySubTypes.Clear(); foreach (var st in fav.Filters?.SecuritySubTypes ?? Array.Empty<int>()) { _vm.SelectedSecuritySubTypes.Add(st); }
        _vm!.SelectedBankPostingTypes.Clear(); foreach (var bt in fav.Filters?.BankPostingTypes ?? Array.Empty<int>()) { _vm.SelectedBankPostingTypes.Add(bt); }
        _vm!.SelectedBankTextFilters.Clear(); _vm.SelectedBankTextFilters.AddRange(fav.Filters?.BankTextFilters ?? Array.Empty<string>());
        _vm!.SelectedContactTextFilters.Clear(); _vm.SelectedContactTextFilters.AddRange(fav.Filters?.ContactTextFilters ?? Array.Empty<string>());
        _vm!.SelectedSavingsPlanTextFilters.Clear(); _vm.SelectedSavingsPlanTextFilters.AddRange(fav.Filters?.SavingsPlanTextFilters ?? Array.Empty<string>());
        _vm!.SelectedSecurityTextFilters.Clear(); _vm.SelectedSecurityTextFilters.AddRange(fav.Filters?.SecurityTextFilters ?? Array.Empty<string>());
        _vm!.IncludeDividendRelated = _includeDividendRelated;
        // restore date kind selection from favorite
        _useValutaDate = fav.UseValutaDate;
        _vm!.UseValutaDate = _useValutaDate;
        _savingsPlanLinkedPostings = fav.SavingsPlanPostingSource == SavingsPlanPostingSource.LinkedAccountPostings;
        _vm!.SavingsPlanPostingSource = fav.SavingsPlanPostingSource;
        _vm!.CompareProjection = _compareProjection;
          _ = _vm!.LoadFilterOptionsAsync();
       _ = LoadAsync();
    }

