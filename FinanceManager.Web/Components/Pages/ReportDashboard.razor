    private void OnToggleKind(PostingKind value, bool isChecked)
    {
        var beforePrimary = PrimaryKind;
        if (isChecked)
        {
            if (!_selectedKinds.Contains(value)) { _selectedKinds.Add(value); }
        }
        else
        {
            _selectedKinds.Remove(value);
            if (_selectedKinds.Count == 0)
            {
                // At least one kind must stay selected: the deselected kind is restored, so
                // the click is a no-op and cannot silently destroy its still-visible filters.
                _selectedKinds.Add(value);
            }
            else
            {
                // A removed kind can no longer show its filter selections in the filter
                // dialog; drop them so they cannot stay active invisibly (badge, favorites).
                _vm!.ClearKindFilters(value);
            }
        }
        _selectedKinds = _selectedKinds.Distinct().ToList();
        if (!CanCompareProjection)
        {
            _compareProjection = false;
        }
        if (beforePrimary != PrimaryKind || IsMulti)
        {
            ClearFilters();
            _ = _vm!.LoadFilterOptionsAsync();
        }
        _ = LoadAsync();
    }

