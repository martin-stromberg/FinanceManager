@using FinanceManager.Shared.Dtos.Portfolio
@using FinanceManager.Web.Components.Shared
@inject Microsoft.Extensions.Localization.IStringLocalizer<FinanceManager.Web.Pages> Localizer

<PortfolioKpiCard Title="@Localizer["PortfolioReport_Tile_Performance"].Value">
    @if (Data.AnnualReturns.Count > 0)
    {
        <MiniBarChart Points="@(Data.AnnualReturns.Select(pt => new MiniBarChart.MiniBarChartPoint(pt.Year.ToString() + (pt.IsYtd ? "*" : string.Empty), pt.ReturnPercent * 100m)).ToList())"
                      AriaLabel="@Localizer["PortfolioReport_Chart_Aria_AnnualReturns"].Value"
                      TooltipFormatter="@(p => $"{p.Label}: {p.Value:N1}%")" />
        @if (Data.AnnualReturns.Any(pt => pt.IsYtd))
        {
            <p class="portfolio-chart-footnote">@Localizer["PortfolioReport_YtdChartFootnote"]</p>
        }
    }

    <div class="portfolio-kpi-row">
        <span class="portfolio-kpi-label-wrap">
            <span class="portfolio-kpi-label">@Localizer["PortfolioReport_Twr"]</span>
            <KpiInfoButton Title="@Localizer["PortfolioReport_Explain_Twr_Title"].Value" CloseLabel="@Localizer["Btn_Close"].Value">
                <p>@Localizer["PortfolioReport_Explain_Twr_Text"]</p>
            </KpiInfoButton>
        </span>
        <span class="portfolio-kpi-value">@(Data.TimeWeightedReturn.HasValue ? (Data.TimeWeightedReturn.Value * 100m).ToString("N2") + "%" : "–")</span>
    </div>
    <div class="portfolio-kpi-row">
        <span class="portfolio-kpi-label-wrap">
            <span class="portfolio-kpi-label">@Localizer["PortfolioReport_Ytd"]</span>
            <KpiInfoButton Title="@Localizer["PortfolioReport_Explain_Ytd_Title"].Value" CloseLabel="@Localizer["Btn_Close"].Value">
                <p>@Localizer["PortfolioReport_Explain_Ytd_Text"]</p>
            </KpiInfoButton>
        </span>
        <span class="portfolio-kpi-value">@(Data.YtdReturn.HasValue ? (Data.YtdReturn.Value * 100m).ToString("N2") + "%" : "–")</span>
    </div>

    @if (Data.AnnualReturns.Count > 0)
    {
        <h4>@Localizer["PortfolioReport_AnnualReturns"]</h4>
        <table class="portfolio-return-table">
            <thead>
                <tr>
                    <th>@Localizer["PortfolioReport_Th_Year"]</th>
                    <th>@Localizer["PortfolioReport_Th_Return"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pt in Data.AnnualReturns)
                {
                    <tr>
                        <td>@pt.Year@(pt.IsYtd ? Localizer["PortfolioReport_YtdSuffix"].Value : "")</td>
                        <td class="@(pt.ReturnPercent >= 0 ? "positive" : "negative")">@((pt.ReturnPercent * 100m).ToString("N2"))%</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</PortfolioKpiCard>

@code {
    /// <summary>Portfolio performance data to display.</summary>
    [Parameter, EditorRequired] public PortfolioPerformanceDto Data { get; set; } = null!;
}
