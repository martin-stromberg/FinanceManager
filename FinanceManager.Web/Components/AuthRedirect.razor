@inject NavigationManager Nav
@inject FinanceManager.Application.ICurrentUserService CurrentUser
@inject FinanceManager.Application.Users.IUserReadService UserRead
@inject FinanceManager.Shared.IApiClient ApiClient
@inject IJSRuntime JS
@using FinanceManager.Shared
@using FinanceManager.Web.Infrastructure.Auth
@implements IDisposable
@rendermode InteractiveServer

@code {
    private bool _initialized;
    private string _lastPath = string.Empty;
    private bool _redirecting;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        ApiClient.AuthenticationRequired += OnAuthenticationRequired;
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        await CheckRedirectAsync(e.Location);
    }

    private void OnAuthenticationRequired(object? sender, ApiAuthenticationRequiredEventArgs e)
    {
        _ = InvokeAsync(() => RedirectToLoginAsync(null));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;
            await CheckRedirectAsync(Nav.Uri);
        }
    }

    private async Task CheckRedirectAsync(string uri)
    {
        try
        {
            var path = GetPath(uri);
            if (path == _lastPath)
            {
                return; // prevent re-entrancy loops
            }
            _lastPath = path;

            // Allowlist of public routes
            if (AuthReturnUrl.IsPublicPath(path))
            {
                return;
            }

            if (!await IsAuthenticatedAsync())
            {
                // Decide whether to go to register (first user) or login
                bool anyUsers = await UserRead.HasAnyUsersAsync(CancellationToken.None);
                var target = anyUsers ? "/login" : "/register";
                if (!string.Equals(path, target, StringComparison.OrdinalIgnoreCase))
                {
                    if (anyUsers)
                    {
                        await RedirectToLoginAsync(AuthReturnUrl.FromNavigationUri(Nav.BaseUri, uri));
                    }
                    else
                    {
                        _redirecting = true;
                        Nav.NavigateTo(target, forceLoad: true);
                    }
                }
            }
        }
        catch
        {
            // swallow - redirect helper must never throw
        }
    }

    private static string GetPath(string uri)
    {
        if (string.IsNullOrEmpty(uri)) return "/";
        var idx = uri.IndexOf("//", StringComparison.Ordinal);
        if (idx >= 0)
        {
            var pathIdx = uri.IndexOf('/', idx + 2);
            if (pathIdx >= 0)
            {
                var endIdx = FindPathEnd(uri, pathIdx);
                return endIdx >= 0 ? uri.Substring(pathIdx, endIdx - pathIdx) : uri[pathIdx..];
            }
            return "/";
        }

        var relativeEndIdx = FindPathEnd(uri, 0);
        return relativeEndIdx >= 0 ? uri[..relativeEndIdx] : uri;
    }

    private static int FindPathEnd(string uri, int startIndex)
    {
        var queryIndex = uri.IndexOf('?', startIndex);
        var fragmentIndex = uri.IndexOf('#', startIndex);

        return queryIndex switch
        {
            >= 0 when fragmentIndex >= 0 => Math.Min(queryIndex, fragmentIndex),
            >= 0 => queryIndex,
            _ => fragmentIndex
        };
    }

    private async Task RedirectToLoginAsync(string? explicitReturnUrl)
    {
        if (_redirecting)
        {
            return;
        }

        var path = GetPath(Nav.Uri);
        if (AuthReturnUrl.IsPublicPath(path))
        {
            return;
        }

        if (!await UserRead.HasAnyUsersAsync(CancellationToken.None))
        {
            _redirecting = true;
            Nav.NavigateTo("/register", forceLoad: true);
            return;
        }

        var returnUrl = AuthReturnUrl.Validate(explicitReturnUrl)
            ?? AuthReturnUrl.FromNavigationUri(Nav.BaseUri, Nav.Uri);

        _redirecting = true;
        Nav.NavigateTo(AuthReturnUrl.BuildLoginUrl(returnUrl), forceLoad: true);
    }

    private async Task<bool> IsAuthenticatedAsync()
    {
        if (CurrentUser.IsAuthenticated)
        {
            return true;
        }

        try
        {
            return await JS.InvokeAsync<bool>("fmAuthIsAuthenticated");
        }
        catch
        {
            return false;
        }
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        ApiClient.AuthenticationRequired -= OnAuthenticationRequired;
    }
}
