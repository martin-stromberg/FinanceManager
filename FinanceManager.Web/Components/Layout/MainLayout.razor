@inherits LayoutComponentBase
@inject FinanceManager.Application.ICurrentUserService CurrentUser
@inject Microsoft.Extensions.Localization.IStringLocalizer<FinanceManager.Web.Pages> L
@inject Microsoft.AspNetCore.Components.NavigationManager Nav
@inject LoadingBarService LoadingBar
@inject IJSRuntime JS
@implements IDisposable

<div class="app-shell dark-mode @(_isGuest ? "guest" : null)">
    <input type="checkbox" id="nav-toggle" class="nav-toggle" />
    <nav class="sidebar" aria-label="@L["Nav_Rail_AriaLabel"]">
        <div class="brand">
            <span class="brand-logo" aria-hidden="true">@FmLogoMark</span>
            <span class="brand-text">@L["Brand"]</span>
        </div>
        @if (CurrentUser.IsAuthenticated)
        {
            <ul class="nav-links">
                <li>
                    <NavLink href="/" Match="NavLinkMatch.All" title="@L["Nav_Home"]">
                        <svg aria-hidden="true"><use href="icons/sprite.svg#layers" /></svg>
                        <span class="nav-label">@L["Nav_Home"]</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink href="/list/accounts" title="@L["Nav_Accounts"]">
                        <svg aria-hidden="true"><use href="icons/sprite.svg#accounts" /></svg>
                        <span class="nav-label">@L["Nav_Accounts"]</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink href="/list/contacts" title="@L["Nav_Contacts"]">
                        <svg aria-hidden="true"><use href="icons/sprite.svg#groups" /></svg>
                        <span class="nav-label">@L["Nav_Contacts"]</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink href="/list/savings-plans" title="@L["Nav_Plans"]">
                        <svg aria-hidden="true"><use href="icons/sprite.svg#calendar" /></svg>
                        <span class="nav-label">@L["Nav_Plans"]</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink href="/list/securities" title="@L["Nav_Securities"]">
                        <svg aria-hidden="true"><use href="icons/sprite.svg#security" /></svg>
                        <span class="nav-label">@L["Nav_Securities"]</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink href="/list/statement-drafts" title="@L["Nav_StatementDrafts"]">
                        <svg aria-hidden="true"><use href="icons/sprite.svg#postings" /></svg>
                        <span class="nav-label">@L["Nav_StatementDrafts"]</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink href="/list/budget/purposes" title="@L["Nav_Budget"]">
                        <svg aria-hidden="true"><use href="icons/sprite.svg#tag" /></svg>
                        <span class="nav-label">@L["Nav_Budget"]</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink href="/reports" title="@L["Nav_Reports"]">
                        <svg aria-hidden="true"><use href="icons/sprite.svg#chart" /></svg>
                        <span class="nav-label">@L["Nav_Reports"]</span>
                    </NavLink>
                </li>
                <li class="nav-sep" aria-hidden="true"></li>
                @if (CurrentUser.IsAdmin)
                {
                    <li>
                        <NavLink href="/list/users" title="@L["Nav_UserManagement"]">
                            <svg aria-hidden="true"><use href="icons/sprite.svg#account" /></svg>
                            <span class="nav-label">@L["Nav_UserManagement"]</span>
                        </NavLink>
                    </li>
                }
                <li>
                    <NavLink href="/list/mcp-accesses" title="@L["Nav_McpAccesses"]">
                        <svg aria-hidden="true"><use href="icons/sprite.svg#key" /></svg>
                        <span class="nav-label">@L["Nav_McpAccesses"]</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink href="/card/setup" title="@L["Nav_Settings"]">
                        <svg aria-hidden="true"><use href="icons/sprite.svg#settings" /></svg>
                        <span class="nav-label">@L["Nav_Settings"]</span>
                    </NavLink>
                </li>
                <li class="nav-sep" aria-hidden="true"></li>
                <li>
                    <NavLink href="/help" title="@L["Nav_Help"]">
                        <svg aria-hidden="true"><use href="icons/sprite.svg#info" /></svg>
                        <span class="nav-label">@L["Nav_Help"]</span>
                    </NavLink>
                </li>
                <li>
                    <LogoutNavButton />
                </li>
            </ul>
            <button type="button" class="nav-collapse-toggle" aria-expanded="false"
                    data-label-expand="@L["Nav_Menu_Expand"]" data-label-collapse="@L["Nav_Menu_Collapse"]"
                    title="@L["Nav_Menu_Expand"]">
                <svg aria-hidden="true"><use href="icons/sprite.svg#chevron-right" /></svg>
                <span class="nav-collapse-label">@L["Nav_Menu_Expand"]</span>
            </button>
            <div class="user-area">
                <NavLink href="/legal" class="user-area-link" title="@L["Nav_Legal"]">@L["Nav_Legal"]</NavLink>
                <LoginStatus />
            </div>
        }
        else
        {
            <div class="user-area">
                <LoginStatus />
            </div>
        }
    </nav>
    <header class="topbar">
        <div class="topbar-left">
            <span class="topbar-title">@_sectionTitle</span>
        </div>
    </header>
    <main class="content">
        <div class="mobile-topbar">
            <label for="nav-toggle" class="hamburger" aria-label="@L["Nav_MenuAriaLabel"]">
                <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
                    <path fill="currentColor" d="M3 6h18v2H3V6zm0 5h18v2H3v-2zm0 5h18v2H3v-2z" />
                </svg>
            </label>
            <div class="mobile-brand">
                <span class="brand-logo" aria-hidden="true">@FmLogoMark</span>
                <span class="topbar-title">@_sectionTitle</span>
            </div>
        </div>
        <div class="inner app-inner" style="@(_useFullWidth ? "max-width:none" : null)">
            @Body
        </div>
    </main>
    <label for="nav-toggle" class="mobile-overlay" aria-hidden="true"></label>
</div>

<div id="blazor-error-ui" data-nosnippet>
    @L["Error_Unhandled"]
    <a href="." class="reload">@L["Error_Reload"]</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _useFullWidth;
    private bool _isGuest;
    private string? _sectionTitle;
    private IDisposable? _locationChangingRegistration;
    private bool _keepaliveRegistered;

    private static readonly MarkupString FmLogoMark = new(
        "<svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\">" +
        "<rect x=\"3\" y=\"12\" width=\"4.5\" height=\"8\" rx=\"1\" fill=\"currentColor\"/>" +
        "<rect x=\"10\" y=\"7\" width=\"4.5\" height=\"13\" rx=\"1\" fill=\"currentColor\" opacity=\".75\"/>" +
        "<rect x=\"17\" y=\"3\" width=\"4.5\" height=\"17\" rx=\"1\" fill=\"currentColor\" opacity=\".5\"/>" +
        "</svg>");

    protected override void OnInitialized()
    {
        UpdateChrome(Nav.Uri);
        _locationChangingRegistration = Nav.RegisterLocationChangingHandler(HandleLocationChanging);
        Nav.LocationChanged += HandleLocationChanged;
    }

    private async ValueTask HandleLocationChanging(Microsoft.AspNetCore.Components.Routing.LocationChangingContext context)
    {
        if (context.IsNavigationIntercepted || !string.Equals(Nav.Uri, context.TargetLocation, StringComparison.Ordinal))
        {
            await LoadingBar.StartAsync();
        }
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdateChrome(e.Location);
        _ = PingKeepaliveAsync();
        _ = StopLoadingBarAsync();
        _ = InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _keepaliveRegistered)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("financeManager.keepalive.register");
            _keepaliveRegistered = true;
        }
        catch
        {
            // Keepalive must not affect page rendering when JavaScript is unavailable during prerender/disconnect.
        }

        // The nav rail collapse state is client-side only (localStorage + html class),
        // handled entirely by financeManager.nav in financeManager.js.
    }

    private async Task PingKeepaliveAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("financeManager.keepalive.ping", new { force = true });
        }
        catch
        {
            // Background session maintenance must not surface as a navigation or rendering error.
        }
    }

    private async Task UnregisterKeepaliveAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("financeManager.keepalive.unregister");
        }
        catch
        {
        }
    }

    private async Task StopLoadingBarAsync()
    {
        await LoadingBar.StopAsync();
    }

    private void UpdateChrome(string uri)
    {
        // ToBaseRelativePath strips scheme+host+PathBase, returning a path with no leading
        // slash (e.g. "list/accounts") regardless of any reverse-proxy PathBase prefix.
        string path;
        try
        {
            path = Nav.ToBaseRelativePath(uri).ToLowerInvariant();
        }
        catch
        {
            // Fallback if uri is not a valid absolute URI under the current BaseUri
            path = uri.ToLowerInvariant().TrimStart('/');
        }

        // Strip query parameters (e.g., /card/accounts/{id}?back=...)
        var queryIndex = path.IndexOf('?');
        if (queryIndex >= 0)
        {
            path = path[..queryIndex];
        }

        // Route segments for generic routes (list/{kind}/..., card/{kind}/...)
        var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
        var section = segments.Length == 0 ? string.Empty : segments[0];
        var kind = segments.Length >= 2 && (section == "list" || section == "card")
            ? segments[1]
            : section;

        // Sub-kind of postings lists maps back to the owning section
        if (kind == "postings" && segments.Length >= 3)
        {
            kind = segments[2] switch
            {
                "account" => "accounts",
                "contact" => "contacts",
                "savings-plan" => "savings-plans",
                "security" => "securities",
                _ => "statement-drafts"
            };
        }

        _sectionTitle = kind switch
        {
            "" => L["Nav_Home"].Value,
            "accounts" => L["Nav_Accounts"].Value,
            "contacts" => L["Nav_Contacts"].Value,
            "savings-plans" => L["Nav_Plans"].Value,
            "securities" or "portfolio" => L["Nav_Securities"].Value,
            "statement-drafts" or "postings" => L["Nav_StatementDrafts"].Value,
            "budget" or "budgets" => L["Nav_Budget"].Value,
            "reports" => L["Nav_Reports"].Value,
            "users" => L["Nav_UserManagement"].Value,
            "mcp-accesses" or "mcp-approvals" or "mcp-audit" or "mcp-security" => L["Nav_McpAccesses"].Value,
            "setup" or "change-password" => L["Nav_Settings"].Value,
            "help" => L["Nav_Help"].Value,
            "legal" => L["Nav_Legal"].Value,
            _ => L["Brand"].Value
        };

        // Guest mode (no rail/topbar chrome) for unauthenticated visitors
        _isGuest = !CurrentUser.IsAuthenticated;

        // Full-width for table-heavy pages
        _useFullWidth = section == "statement-drafts"
            || section == "accounts"
            || section == "reports"
            || section == "securities"
            || section == "savings-plans"
            || section == "contacts"
            || section == "portfolio"
            || section == "list"
            || section == "card";
    }

    public void Dispose()
    {
        Nav.LocationChanged -= HandleLocationChanged;
        _locationChangingRegistration?.Dispose();
        if (_keepaliveRegistered)
        {
            _ = UnregisterKeepaliveAsync();
        }
    }
}
