@inherits LayoutComponentBase
@inject FinanceManager.Application.ICurrentUserService CurrentUser
@inject Microsoft.Extensions.Localization.IStringLocalizer<FinanceManager.Web.Pages> L
@inject Microsoft.AspNetCore.Components.NavigationManager Nav
@inject LoadingBarService LoadingBar
@inject IJSRuntime JS
@implements IDisposable

<div class="app-shell dark-mode @(CurrentUser.IsAuthenticated ? null : "signed-out")">
    <input type="checkbox" id="nav-toggle" class="nav-toggle" />
    <nav class="sidebar">
        <div class="brand">
            <span class="brand-logo-badge" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                    <rect x="3" y="12" width="4.5" height="8" rx="1" fill="currentColor"/>
                    <rect x="10" y="7" width="4.5" height="13" rx="1" fill="currentColor" opacity=".75"/>
                    <rect x="17" y="3" width="4.5" height="17" rx="1" fill="currentColor" opacity=".5"/>
                </svg>
            </span>
            <span class="brand-text">
                <span class="brand-name">@L["Brand"]</span>
                <span class="brand-sub">@L["Brand_Sub"]</span>
            </span>
        </div>
        <ul class="nav-links">
            @if (CurrentUser.IsAuthenticated)
            {
                <li><NavLink href="" Match="NavLinkMatch.All"><svg class="nav-ico"><use href="icons/sprite.svg#nav-home" /></svg><span>@L["Nav_Home"]</span></NavLink></li>
                <li><NavLink href="list/accounts"><svg class="nav-ico"><use href="icons/sprite.svg#bank" /></svg><span>@L["Nav_Accounts"]</span></NavLink></li>
                <li><NavLink href="list/contacts"><svg class="nav-ico"><use href="icons/sprite.svg#nav-contacts" /></svg><span>@L["Nav_Contacts"]</span></NavLink></li>
                <li><NavLink href="list/savings-plans"><svg class="nav-ico"><use href="icons/sprite.svg#nav-savings" /></svg><span>@L["Nav_Plans"]</span></NavLink></li>
                <li><NavLink href="list/securities"><svg class="nav-ico"><use href="icons/sprite.svg#nav-trending" /></svg><span>@L["Nav_Securities"]</span></NavLink></li>
                <li><NavLink href="list/statement-drafts" Match="NavLinkMatch.All"><svg class="nav-ico"><use href="icons/sprite.svg#nav-receipt" /></svg><span>@L["Nav_StatementDrafts"]</span></NavLink></li>
                <li><NavLink href="list/budget/purposes"><svg class="nav-ico"><use href="icons/sprite.svg#nav-pie" /></svg><span>@L["Nav_Budget"]</span></NavLink></li>
                <li><NavLink href="reports"><svg class="nav-ico"><use href="icons/sprite.svg#chart" /></svg><span>@L["Nav_Reports"]</span></NavLink></li>
                <li class="nav-sep" aria-hidden="true"></li>
                @if (CurrentUser.IsAdmin)
                {
                    <li><NavLink href="list/users"><svg class="nav-ico"><use href="icons/sprite.svg#groups" /></svg><span>@L["Nav_UserManagement"]</span></NavLink></li>
                }
                <li><NavLink href="list/mcp-accesses"><svg class="nav-ico"><use href="icons/sprite.svg#nav-ai" /></svg><span>@L["Nav_McpAccesses"]</span></NavLink></li>
                <li><NavLink href="card/setup"><svg class="nav-ico"><use href="icons/sprite.svg#settings" /></svg><span>@L["Nav_Settings"]</span></NavLink></li>
                <li class="nav-sep" aria-hidden="true"></li>
                <li><NavLink href="help"><svg class="nav-ico"><use href="icons/sprite.svg#nav-help" /></svg><span>@L["Nav_Help"]</span></NavLink></li>
                <li>
                    <button type="button" class="nav-entry" @onclick="LogoutAsync">
                        <svg class="nav-ico"><use href="icons/sprite.svg#nav-logout" /></svg><span>@L["Nav_Logout"]</span>
                    </button>
                </li>
            }
        </ul>
        @if (CurrentUser.IsAuthenticated)
        {
            <div class="user-area">
                <NavLink class="legal-link" href="legal">@L["Nav_Legal"]</NavLink>
                <LoginStatus />
            </div>
        }
    </nav>
    <main class="content">
        <div class="mobile-topbar">
            <label for="nav-toggle" class="hamburger" aria-label="@L["Nav_MenuAriaLabel"]">
                <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
                    <path fill="currentColor" d="M3 6h18v2H3V6zm0 5h18v2H3v-2zm0 5h18v2H3v-2z" />
                </svg>
            </label>
            <div class="mobile-brand">
                <span class="brand-logo-badge" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                        <rect x="3" y="12" width="4.5" height="8" rx="1" fill="currentColor"/>
                        <rect x="10" y="7" width="4.5" height="13" rx="1" fill="currentColor" opacity=".75"/>
                        <rect x="17" y="3" width="4.5" height="17" rx="1" fill="currentColor" opacity=".5"/>
                    </svg>
                </span>
                <span class="page-title">@_pageTitle</span>
            </div>
        </div>
        @if (CurrentUser.IsAuthenticated)
        {
            <div class="topbar">
                <span class="page-title">@_pageTitle</span>
                <span class="avatar" aria-hidden="true">
                    <svg><use href="icons/sprite.svg#account" /></svg>
                </span>
            </div>
        }
        else
        {
            <div class="public-brand">
                <span class="brand-logo-badge" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                        <rect x="3" y="12" width="4.5" height="8" rx="1" fill="currentColor"/>
                        <rect x="10" y="7" width="4.5" height="13" rx="1" fill="currentColor" opacity=".75"/>
                        <rect x="17" y="3" width="4.5" height="17" rx="1" fill="currentColor" opacity=".5"/>
                    </svg>
                </span>
                <span class="public-brand-name">@L["Brand"]</span>
                <div class="public-nav">
                    <NavLink class="legal-link" href="legal">@L["Nav_Legal"]</NavLink>
                    <LoginStatus />
                </div>
            </div>
        }
        <div class="inner app-inner @(!CurrentUser.IsAuthenticated && _authCard ? "inner-auth" : null)" style="@(_useFullWidth && CurrentUser.IsAuthenticated ? "max-width:none" : null)">
            @Body
        </div>
    </main>
    <label for="nav-toggle" class="mobile-overlay" aria-hidden="true"></label>
</div>

<div id="blazor-error-ui" data-nosnippet>
    @L["Error_Unhandled"]
    <a href="." class="reload">@L["Error_Reload"]</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string _pageTitle = string.Empty;
    private bool _useFullWidth;
    private bool _authCard;
    private IDisposable? _locationChangingRegistration;
    private bool _keepaliveRegistered;

    protected override void OnInitialized()
    {
        UpdateChrome(Nav.Uri);
        _locationChangingRegistration = Nav.RegisterLocationChangingHandler(HandleLocationChanging);
        Nav.LocationChanged += HandleLocationChanged;
    }

    private async ValueTask HandleLocationChanging(Microsoft.AspNetCore.Components.Routing.LocationChangingContext context)
    {
        if (context.IsNavigationIntercepted || !string.Equals(Nav.Uri, context.TargetLocation, StringComparison.Ordinal))
        {
            await LoadingBar.StartAsync();
        }
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdateChrome(e.Location);
        _ = PingKeepaliveAsync();
        _ = StopLoadingBarAsync();
        _ = InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _keepaliveRegistered)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("financeManager.keepalive.register");
            _keepaliveRegistered = true;
        }
        catch
        {
            // Keepalive must not affect page rendering when JavaScript is unavailable during prerender/disconnect.
        }
    }

    private async Task PingKeepaliveAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("financeManager.keepalive.ping", new { force = true });
        }
        catch
        {
            // Background session maintenance must not surface as a navigation or rendering error.
        }
    }

    private async Task UnregisterKeepaliveAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("financeManager.keepalive.unregister");
        }
        catch
        {
        }
    }

    private async Task StopLoadingBarAsync()
    {
        await LoadingBar.StopAsync();
    }

    private async Task LogoutAsync()
    {
        try
        {
            await JS.InvokeAsync<bool>("fmAuthLogout");
        }
        catch
        {
            // Fallback below: forced navigation still lands on the login page.
        }
        Nav.NavigateTo("login", forceLoad: true);
    }

    private void UpdateChrome(string uri)
    {
        // ToBaseRelativePath strips scheme+host+PathBase, returning a path with no leading
        // slash (e.g. "list/accounts") regardless of any reverse-proxy PathBase prefix.
        string path;
        try
        {
            path = Nav.ToBaseRelativePath(uri).ToLowerInvariant();
        }
        catch
        {
            // Fallback if uri is not a valid absolute URI under the current BaseUri
            path = uri.ToLowerInvariant().TrimStart('/');
        }

        _pageTitle = GetPageTitle(path);

        // Narrow centered card for auth views (login/register/error) when signed out;
        // other public pages (e.g. legal) keep the wider signed-out card.
        _authCard = path.StartsWith("login")
            || path.StartsWith("register")
            || path.StartsWith("error");

        // Full-width for table-heavy pages
        _useFullWidth = path.StartsWith("statement-drafts")
            || path.StartsWith("accounts")
            || path.StartsWith("reports")
            || path.StartsWith("securities")
            || path.StartsWith("savings-plans")
            || path.StartsWith("contacts")
            || path.StartsWith("portfolio")
            || path.StartsWith("list/")
            || path.StartsWith("card/");
    }

    private string GetPageTitle(string path)
    {
        var key = ResolveTitleKey(path);
        return L[key].Value;
    }

    private static string ResolveTitleKey(string path)
    {
        var parts = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
        var kind = parts.Length >= 2 ? parts[1] : null;

        if (path.StartsWith("list/", StringComparison.Ordinal))
        {
            return kind switch
            {
                "accounts" => "Nav_Accounts",
                "contacts" => "Nav_Contacts",
                "savings-plans" => "Nav_Plans",
                "securities" => "Nav_Securities",
                "statement-drafts" => "Nav_StatementDrafts",
                "budget" => "Nav_Budget",
                "users" => "Nav_UserManagement",
                "mcp-accesses" => "Nav_McpAccesses",
                "postings" => parts.Length >= 3 ? parts[2] switch
                {
                    "contact" => "Nav_Contacts",
                    "savings-plan" => "Nav_Plans",
                    "security" => "Nav_Securities",
                    _ => "Nav_Accounts",
                } : "Nav_Accounts",
                _ => "Brand",
            };
        }

        if (path.StartsWith("card/", StringComparison.Ordinal))
        {
            return kind switch
            {
                "accounts" => "Nav_Accounts",
                "contacts" => "Nav_Contacts",
                "savings-plans" => "Nav_Plans",
                "securities" => "Nav_Securities",
                "statement-drafts" => "Nav_StatementDrafts",
                "budget" => "Nav_Budget",
                "users" => "Nav_UserManagement",
                "setup" => "Nav_Settings",
                "postings" => "Nav_Accounts",
                "mcp-accesses" or "mcp-approvals" or "mcp-audit" or "mcp-security" => "Nav_McpAccesses",
                _ => "Brand",
            };
        }

        if (path.StartsWith("reports", StringComparison.Ordinal)
            || path.StartsWith("portfolio", StringComparison.Ordinal))
        {
            return "Nav_Reports";
        }
        if (path.StartsWith("securities", StringComparison.Ordinal))
        {
            return "Nav_Securities";
        }
        if (path.StartsWith("change-password", StringComparison.Ordinal))
        {
            return "Nav_ChangePassword";
        }
        if (path.StartsWith("legal", StringComparison.Ordinal))
        {
            return "Nav_Legal";
        }
        if (path.StartsWith("help", StringComparison.Ordinal))
        {
            return "Nav_Help";
        }
        return "Nav_Home";
    }

    public void Dispose()
    {
        Nav.LocationChanged -= HandleLocationChanged;
        _locationChangingRegistration?.Dispose();
        if (_keepaliveRegistered)
        {
            _ = UnregisterKeepaliveAsync();
        }
    }
}
