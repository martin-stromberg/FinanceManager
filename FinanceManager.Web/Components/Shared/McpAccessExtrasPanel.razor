@using FinanceManager.Domain.Mcp
@using FinanceManager.Web.ViewModels.Mcp
@implements IDisposable
@inject Microsoft.Extensions.Localization.IStringLocalizer<FinanceManager.Web.Pages> L

@if (Provider?.Access is { } access)
{
    <div class="mcp-access-extras" style="display:flex;flex-direction:column;gap:.75rem;margin-top:1.25rem;">

        @if ((McpApprovalMode)access.ApprovalMode == McpApprovalMode.PreApproved
            && (McpAccessStatus)access.Status == McpAccessStatus.Active)
        {
            <div role="alert" style="padding:.6rem .9rem;border:1px solid rgba(230,160,60,.5);background:rgba(230,160,60,.08);border-radius:6px;">
                @L["Mcp_PreApproved_Banner"]
            </div>
        }

        <section class="mcp-section" style="border:1px solid var(--border,#444);border-radius:6px;padding:.75rem 1rem;">
            <h4 style="margin:0 0 .5rem 0;">@L["Mcp_Section_Token"]</h4>
            @if (Provider.Options is not null && !Provider.Options.IsTlsRequest)
            {
                <div style="padding:.5rem .75rem;margin-bottom:.5rem;border:1px solid rgba(230,160,60,.35);background:rgba(230,160,60,.05);border-radius:6px;">
                    @L["Mcp_Token_TlsWarning"]
                </div>
            }
            <div style="display:flex;flex-wrap:wrap;gap:1rem;font-size:.95rem;">
                <div>
                    <span style="color:var(--muted);">@L["Mcp_Token_IssuedUtc"]</span>
                    <div>@access.TokenIssuedUtc.ToString("u")</div>
                </div>
                <div>
                    <span style="color:var(--muted);">@L["Mcp_Token_Status"]</span>
                    <div>@McpAccessText.Status(L, access.Status, access.IsExpired)</div>
                </div>
            </div>
            <div style="margin-top:.5rem;color:var(--muted);font-size:.9rem;">@L["Mcp_Token_NoPlaintext"]</div>
            @if ((McpAccessStatus)access.Status != McpAccessStatus.Revoked)
            {
                <div style="margin-top:.5rem;">
                    <button type="button" class="btn" @onclick="RotateAsync">@L["Mcp_Ribbon_RotateToken"]</button>
                </div>
            }
        </section>

        <section class="mcp-section" style="border:1px solid var(--border,#444);border-radius:6px;padding:.75rem 1rem;">
            <h4 style="margin:0 0 .5rem 0;">@L["Mcp_Section_Rights"]</h4>
            <div style="margin-bottom:.4rem;">
                <span style="color:var(--muted);">@L["Mcp_Rights_Level"]</span>
                <strong> @McpAccessText.Level(L, access.Level)</strong>
            </div>
            <div style="color:var(--muted);font-size:.9rem;margin-bottom:.5rem;">
                @McpAccessText.LevelDescription(L, access.Level)
            </div>
            <McpRightsEditor Provider="Provider" />
        </section>

        <section class="mcp-section" style="border:1px solid var(--border,#444);border-radius:6px;padding:.75rem 1rem;">
            <h4 style="margin:0 0 .5rem 0;">@L["Mcp_Section_StatusActions"]</h4>
            <div style="display:flex;flex-wrap:wrap;gap:.5rem;">
                @if ((McpAccessStatus)access.Status == McpAccessStatus.Active)
                {
                    <button type="button" class="btn" @onclick="DeactivateAsync">@L["Ribbon_Deactivate"]</button>
                }
                else if ((McpAccessStatus)access.Status == McpAccessStatus.Deactivated)
                {
                    <button type="button" class="btn" @onclick="ActivateAsync">@L["Ribbon_Activate"]</button>
                }
                @if ((McpAccessStatus)access.Status != McpAccessStatus.Revoked)
                {
                    <button type="button" class="btn btn-danger" @onclick="RevokeAsync">@L["Mcp_Ribbon_Revoke"]</button>
                }
            </div>
            <div style="margin-top:.5rem;color:var(--muted);font-size:.85rem;">@L["Mcp_StatusActions_Hint"]</div>
        </section>

        <section class="mcp-section" style="border:1px solid var(--border,#444);border-radius:6px;padding:.75rem 1rem;">
            <h4 style="margin:0 0 .5rem 0;">@L["Mcp_Section_Usage"]</h4>
            <div style="display:flex;flex-wrap:wrap;gap:1rem;font-size:.95rem;">
                <div>
                    <span style="color:var(--muted);">@L["Mcp_Card_LastUsedUtc"]</span>
                    <div>@(access.LastUsedUtc?.ToString("u") ?? L["Mcp_Value_NeverUsed"].Value)</div>
                </div>
            </div>
            @if (Provider.Usage is { } usage)
            {
                @if (usage.TotalCalls == 0)
                {
                    <div style="margin-top:.5rem;color:var(--muted);font-size:.85rem;">@L["Mcp_Usage_Empty"]</div>
                }
                else
                {
                    <div style="display:flex;flex-wrap:wrap;gap:1.25rem;margin-top:.6rem;font-size:.95rem;">
                        <div>
                            <span style="color:var(--muted);">@L["Mcp_Usage_TotalCalls"]</span>
                            <div>@usage.TotalCalls</div>
                        </div>
                        <div>
                            <span style="color:var(--muted);">@L["Mcp_Usage_Success"]</span>
                            <div>@usage.SuccessCalls</div>
                        </div>
                        <div>
                            <span style="color:var(--muted);">@L["Mcp_Usage_Failed"]</span>
                            <div>@usage.FailedCalls</div>
                        </div>
                        <div>
                            <span style="color:var(--muted);">@L["Mcp_Usage_FailureRate"]</span>
                            <div>@usage.FailureRate.ToString("P0")</div>
                        </div>
                        @if (usage.LastCallUtc is DateTime lastCall)
                        {
                            <div>
                                <span style="color:var(--muted);">@L["Mcp_Usage_LastCall"]</span>
                                <div>@lastCall.ToString("u")</div>
                            </div>
                        }
                    </div>
                    @if (usage.TopTools.Count > 0)
                    {
                        <div style="margin-top:.6rem;">
                            <span style="color:var(--muted);font-size:.85rem;">@L["Mcp_Usage_TopTools"]</span>
                            <div style="margin-top:.2rem;">
                                @foreach (var t in usage.TopTools)
                                {
                                    <span style="display:inline-block;margin:.1rem .3rem .1rem 0;padding:.1rem .45rem;border:1px solid var(--border,#555);border-radius:10px;font-size:.8rem;">
                                        <code>@t.ToolName</code> ×@t.CallCount
                                    </span>
                                }
                            </div>
                        </div>
                    }
                    @if (usage.RecentCalls.Count > 0)
                    {
                        <div style="margin-top:.6rem;">
                            <span style="color:var(--muted);font-size:.85rem;">@L["Mcp_Usage_RecentCalls"]</span>
                            <div style="margin-top:.2rem;font-size:.85rem;">
                                @foreach (var r in usage.RecentCalls)
                                {
                                    <div style="display:flex;gap:.6rem;padding:.15rem 0;border-top:1px solid var(--border,#333);">
                                        <span style="color:var(--muted);min-width:8.5rem;">@r.Utc.ToString("g")</span>
                                        <span><code>@(r.ToolName ?? r.EventType)</code></span>
                                        <span style="color:@(r.ResultStatus == "Success" ? "var(--muted)" : "#e6a03c");">@McpAuditText.Result(L, r.ResultStatus)</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            }
            <div style="margin-top:.6rem;">
                <a href="/card/mcp-audit?accessId=@access.Id">@L["Mcp_Usage_OpenHistory"]</a>
            </div>
        </section>

        <section class="mcp-section" style="border:1px solid var(--border,#444);border-radius:6px;padding:.75rem 1rem;">
            <h4 style="margin:0 0 .5rem 0;">@L["Mcp_Section_Monitoring"]</h4>
            @if (Provider.Monitoring is { } mon)
            {
                <div style="display:flex;flex-wrap:wrap;gap:1.25rem;font-size:.95rem;">
                    <div>
                        <span style="color:var(--muted);">@L["Mcp_Monitor_Pending"]</span>
                        <div>@mon.PendingCount</div>
                    </div>
                    <div>
                        <span style="color:var(--muted);">@L["Mcp_Monitor_Approved"]</span>
                        <div>@mon.ApprovedCount</div>
                    </div>
                    @if (mon.OldestPendingUtc is DateTime oldest)
                    {
                        <div>
                            <span style="color:var(--muted);">@L["Mcp_Monitor_OldestPending"]</span>
                            <div>@oldest.ToString("u")</div>
                        </div>
                    }
                    <div>
                        <span style="color:var(--muted);">@L["Mcp_Monitor_Last24h"]</span>
                        <div>
                            @mon.RequestsLast24h / @mon.ExecutedLast24h / @mon.FailedLast24h
                            <span style="color:var(--muted);font-size:.8rem;">(@mon.FailureRateLast24h.ToString("P0"))</span>
                        </div>
                    </div>
                </div>
                <div style="margin-top:.35rem;color:var(--muted);font-size:.8rem;">
                    @L["McpApproval_View_History"]: <a href="/card/mcp-approvals">@L["McpApproval_Title"]</a>
                </div>
            }
            else
            {
                <div style="color:var(--muted);font-size:.85rem;">@L["Mcp_Monitor_Empty"]</div>
            }
        </section>
    </div>
}

@code {
    /// <summary>The owning card view model.</summary>
    [Parameter] public McpAccessCardViewModel? Provider { get; set; }

    private McpAccessCardViewModel? _subscribed;

    protected override void OnParametersSet()
    {
        if (_subscribed != Provider)
        {
            if (_subscribed is not null)
            {
                _subscribed.StateChanged -= OnStateChanged;
            }
            _subscribed = Provider;
            if (_subscribed is not null)
            {
                _subscribed.StateChanged += OnStateChanged;
            }
        }
    }

    private void OnStateChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    private Task RotateAsync() => Provider is null ? Task.CompletedTask : Provider.RotateTokenAsync();
    private Task ActivateAsync() => Provider is null ? Task.CompletedTask : Provider.ActivateAsync();
    private Task DeactivateAsync() => Provider is null ? Task.CompletedTask : Provider.DeactivateAsync();
    private Task RevokeAsync() => Provider is null ? Task.CompletedTask : Provider.RevokeAsync();

    /// <inheritdoc />
    public void Dispose()
    {
        if (_subscribed is not null)
        {
            _subscribed.StateChanged -= OnStateChanged;
        }
    }
}
