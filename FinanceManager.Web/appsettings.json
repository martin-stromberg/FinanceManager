{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // Host-header filtering (HostFilteringMiddleware). "*" accepts every Host header, so
  // direct HTTP access via LAN IP (http://192.168.x.x), LAN hostname (http://my-server)
  // and reverse proxies forwarding the original host keep working out of the box.
  // To harden, set a deployment-specific semicolon-separated list of allowed hostnames/IPs
  // here or via the "AllowedHosts" environment variable, e.g.
  // "myserver;myserver.local;192.168.1.10" - requests with any other Host header are then
  // rejected with HTTP 400.
  "AllowedHosts": "*",
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 20971520
    }
  },
  "Jwt": {
    "Key": "",
    "Issuer": "financemanager",
    "Audience": "financemanager",
    "LifetimeMinutes": 30
  },
  "AlphaVantage": {
    "Quota": {
      "MaxSymbolsPerRun": 8,
      "RequestsPerMinute": 4
    }
  },
  "BackgroundTasks": {
    "Enabled": true
  },
  "Workers": {
    "SecurityPriceWorker": {
      "Enabled": true
    }
  },
  "Updates": {
    "Enabled": false,
    "HostedServicesEnabled": true,
    "SourceCheckStartTime": "20:00:00",
    "SourceCheckEndTime": "06:00:00",
    "RepositoryOwner": "martin-stromberg",
    "RepositoryName": "FinanceManager",
    "ManifestAssetName": "update.json",
    "WorkingDirectory": "updates",
    "ServiceName": null,
    "HealthTimeoutSeconds": 120,
    "MaxAssetBytes": 536870912,
    "SourceType": "Github",
    "LocalFolderPath": null,
    "EnableAutomaticDownload": true,
    "EnableAutomaticInstallation": false,
    "StopHostAfterScriptStart": false
  },
  "MassImport": {
    "MaxRequestBytes": 150000000,
    "MaxFiles": 50,
    "MaxBytesPerFile": 10485760,
    "MaxTotalContentBytes": 104857600
  },
  "Auth": {
    "AllowSelfRegistration": false
  },
  // MCP integration (Issue #470): opt-in feature. The kill switch and the write-stop
  // lid are database-stored admin settings (McpSettings row, /card/mcp-security) — both
  // default to off. All remaining Mcp:* values stay appsettings-bound here.
  "Mcp": {
    "TokenHash": {
      "Iterations": 100000
    },
    "RateLimiting": {
      "Endpoint": {
        "PermitLimit": 600,
        "WindowSeconds": 60
      },
      "Unauthenticated": {
        "PermitLimit": 60,
        "WindowSeconds": 60
      },
      "Lesend": {
        "PermitLimit": 300,
        "WindowSeconds": 60
      },
      "Vorschlagend": {
        "PermitLimit": 60,
        "WindowSeconds": 60
      },
      "Schreibvorbereitend": {
        "PermitLimit": 30,
        "WindowSeconds": 60
      },
      "Genehmigungspflichtig": {
        "PermitLimit": 10,
        "WindowSeconds": 60
      },
      "Meta": {
        "PermitLimit": 60,
        "WindowSeconds": 60
      }
    },
    "Approval": {
      "DefaultExpiryHours": 72,
      "MaxPendingPerAccess": 25,
      "ExecutorPollSeconds": 5,
      "ExecutionTimeoutSeconds": 300,
      "ExpiryCheckIntervalMinutes": 15,
      "MaxExecutionBatchSize": 20,
      "ClaimStaleMinutes": 10
    },
    "Anomaly": {
      "ScopeDenialThreshold": 25,
      "ScopeDenialWindowMinutes": 10,
      // Agent-workload alert: N failed request executions within the window notify the
      // access owner once per NotificationCooldownMinutes (F-1103).
      "ExecutionFailureThreshold": 5,
      "ExecutionFailureWindowMinutes": 30,
      "NotificationCooldownMinutes": 30
    },
    // SSE streamable-HTTP upgrade (GET /mcp with Accept: text/event-stream, F-1101):
    // keep-alive comment interval and the per-access cap of concurrent streams.
    "Sse": {
      "HeartbeatSeconds": 15,
      "MaxSubscribersPerAccess": 4
    },
    // Retention sweep (F-1104, audit-konzept.md §5): ToolCall/AccessEvent/SecurityEvent
    // entries older than ToolCallMonths and ApprovalEvent/DataChange entries older than
    // ApprovalMonths are removed per chain — each purged chain first receives a
    // RetentionPurged anchor entry so the hash chain stays verifiable. Terminal
    // AiActionRequest rows are swept at RequestMonths.
    "Retention": {
      "IntervalMinutes": 720,
      "ToolCallMonths": 12,
      "ApprovalMonths": 36,
      "RequestMonths": 12,
      "BatchSize": 5000
    }
  },
  // Trusted reverse-proxy endpoints whose X-Forwarded-For/-Proto headers are honored.
  // Semicolon-separated values; with both empty (default) no forwarded headers are trusted -
  // required entries when the app runs behind a reverse proxy, e.g.
  // "KnownProxies": "10.0.0.5" / "KnownNetworks": "10.0.0.0/24;fd00::/8".
  "ReverseProxy": {
    "KnownProxies": "",
    "KnownNetworks": ""
  },
  "Backups": {
    "Security": {
      "MaxUploadBytes": 104857600,
      "MaxCompressedZipBytes": 104857600,
      "MaxUncompressedNdjsonBytes": 262144000,
      "MaxZipEntries": 1,
      "MaxCompressionRatio": 25,
      "AllowedEntryNames": [
        "backup.ndjson"
      ],
      "AllowedEntryPrefixes": [
        "backup-"
      ],
      "AllowedBackupVersions": [
        3
      ]
    }
  },
  "FileLogging": {
    "Enabled": false,
    "PathFormat": "logs/app-{date}.log",
    "RetainedFileCountLimit": 30,
    "FileSizeLimitBytes": 10485760,
    "RollOnFileSizeLimit": true,
    "Append": true,
    "IncludeScopes": false,
    "UseUtcTimestamp": false
  },
  "Identity": {
    "Lockout": {
      "DefaultLockoutMinutes": 5,
      "MaxFailedAccessAttempts": 3,
      "AllowedForNewUsers": true
    },
    "Password": {
      "RequireDigit": true,
      "RequiredLength": 8,
      "RequireNonAlphanumeric": false
    }
  }
}
